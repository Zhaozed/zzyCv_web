---
import PageLayout from "@/layouts/Base.astro";

interface Props {
	title: string;
	/** 主标题下方的副标题（一句话定位，可选） */
	subtitle?: string;
	description: string;
	eyebrow: string;
	intro: string;
	tags: string[];
	meta: { label: string; value: string }[];
	/** 概览卡：1–2 个最有说服力的核心结果 */
	results?: { value: string; label: string; note?: string }[];
	/** 核心结果的验证范围 / 统计口径说明 */
	scope?: string;
	backHref?: string;
	backLabel?: string;
}
const {
	title,
	subtitle,
	description,
	eyebrow,
	intro,
	tags,
	meta,
	results = [],
	scope,
	backHref = "/projects/",
	backLabel = "← 返回精选项目",
} = Astro.props;
---

<PageLayout meta={{ title, description }}>
	<section
		class="relative z-20 mx-auto mt-10 max-w-4xl border-neutral-200 px-5 pb-1 md:rounded-t-2xl md:border-t md:border-r md:border-l dark:border-neutral-800"
	>
		<div class="pt-6 md:pt-20">
			<a
				class="mb-10 inline-flex font-mono text-xs text-neutral-400 duration-200 ease-out hover:text-neutral-900 dark:hover:text-white"
				href={backHref}>{backLabel}</a
			>
			<p
				class="mb-4 font-mono text-xs tracking-widest text-neutral-400 uppercase dark:text-neutral-500"
			>
				{eyebrow}
			</p>
			<h1
				class="max-w-3xl text-3xl leading-tight font-bold tracking-tighter md:text-4xl lg:text-5xl dark:text-neutral-100"
			>
				{title}
			</h1>
			{
				subtitle && (
					<p class="mt-4 max-w-3xl text-lg font-medium tracking-tight text-neutral-500 sm:text-xl dark:text-neutral-400">
						{subtitle}
					</p>
				)
			}
			<p
				class="mt-6 max-w-3xl text-base leading-8 text-neutral-600 sm:text-lg dark:text-neutral-400"
			>
				{intro}
			</p>
			<div class="mt-6 flex flex-wrap gap-2">
				{
					tags.map((tag) => (
						<span class="inline-flex rounded-full border border-neutral-300 px-3 py-1 font-mono text-xs dark:border-neutral-600">
							{tag}
						</span>
					))
				}
			</div>

			<div class="case-hero-grid">
				{
					results.length > 0 && (
						<div class="case-results">
							<div class="case-results__head">
								<p class="number-label">核心结果 / Key results</p>
								<span class="case-results__count">
									{String(results.length).padStart(2, "0")} ITEMS
								</span>
							</div>
							<div
								class={`case-results__grid ${
									results.length >= 4
										? "case-results__grid--cols-4"
										: results.length === 3
											? "case-results__grid--cols-3"
											: ""
								}`}
							>
								{results.map((item, i) => (
									<div class="metric-tile">
										<span class="metric-tile__index">{String(i + 1).padStart(2, "0")}</span>
										<strong>{item.value}</strong>
										<p>{item.label}</p>
										{item.note && <span class="metric-tile__note">{item.note}</span>}
									</div>
								))}
							</div>
							{scope && <p class="case-results__scope">{scope}</p>}
						</div>
					)
				}
				<dl class="case-meta">
					{
						meta.map((item) => (
							<div>
								<dt>{item.label}</dt>
								<dd>{item.value}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>
	</section>
	<div class="relative z-20 mx-auto max-w-4xl px-5 pb-20 md:px-10">
		<slot />
	</div>
</PageLayout>
