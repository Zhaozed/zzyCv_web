<script>
	// 1. 页内导航平滑高亮与滚动联动
	const links = [...document.querySelectorAll<HTMLAnchorElement>(".ca-nav a, .ca-mobile-toc a")];
	const sections = [...document.querySelectorAll<HTMLElement>("[data-case-section]")];
	let scheduled = false;

	function updateNavigation() {
		const anchor = 128;
		const active =
			sections.filter(section => section.getBoundingClientRect().top <= anchor).at(-1) ??
			sections[0];
		for (const link of links) {
			if (link.hash === `#${active?.id}`) link.setAttribute("aria-current", "location");
			else link.removeAttribute("aria-current");
		}
		scheduled = false;
	}

	window.addEventListener(
		"scroll",
		() => {
			if (!scheduled) {
				scheduled = true;
				requestAnimationFrame(updateNavigation);
			}
		},
		{ passive: true }
	);
	window.addEventListener("resize", updateNavigation);
	updateNavigation();

	// 移动端 TOC 控制
	const mobileToc = document.querySelector<HTMLDetailsElement>(".ca-mobile-toc");
	for (const link of links)
		link.addEventListener("click", () => {
			if (mobileToc) mobileToc.open = false;
		});

	// 2. 滚动进入视口渐入动画
	const reveals = document.querySelectorAll(".ca-reveal");
	if ("IntersectionObserver" in window) {
		const revealObserver = new IntersectionObserver(
			(entries, observer) => {
				entries.forEach((entry, idx) => {
					if (entry.isIntersecting) {
						setTimeout(
							() => {
								entry.target.classList.add("is-revealed");
							},
							(idx % 4) * 60
						);
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.04, rootMargin: "0px 0px 60px 0px" }
		);
		reveals.forEach(el => revealObserver.observe(el));
	} else {
		reveals.forEach(el => el.classList.add("is-revealed"));
	}

	// 3. 架构节点元数据 (纯业务与产品逻辑，无冗余后端代码路径)
	const INSPECTOR_DATA: Record<
		string,
		{ badge: string; title: string; sub: string; body: string }
	> = {
		"mail-input": {
			badge: "邮件接入",
			title: "📥 同步新邮件",
			sub: "通过 Gmail OAuth 2.0 和 163 IMAP 接入两个邮箱，每 3 分钟检查一次新邮件。",
			body: `• 接入写论文与校招常用的学校 Gmail 与 163 邮箱。
• 服务端常驻每 3 分钟检查一次新邮件并完成模型处理，电脑关机也不中断轮询。
• 桌面端开机即直接呈现整理好的摘要与待办，无需等待实时拉取。`
		},
		prefilter: {
			badge: "规则过滤",
			title: "🧹 过滤无关内容",
			sub: "用正则规则过滤营销推广、验证码和部分全员广播邮件。",
			body: `• 邮件中混有大量营销推广、登录验证码和学校全员广播，没有必要全部交给模型处理。
• 在进入模型前用正则规则快速识别并过滤，减少不必要的模型调用。
• 过滤规则支持本地维护与调整，确保重要通知不被误拦。`
		},
		junk: {
			badge: "过滤结果",
			title: "🗑️ 不再继续处理",
			sub: "命中过滤规则的邮件不调用模型，也不进入待办列表。",
			body: `• 识别为推广、验证码或无关广播的邮件直接归档。
• 不调用模型，不生成待办，保持待办列表和界面的清晰。`
		},
		"llm-inbox": {
			badge: "模型处理",
			title: "🤖 邮件整理",
			sub: "生成摘要，提取待办",
			body: `• 一次模型调用完成三项工作：区分学校事务、日常事务和校招求职。
• 为邮件生成 1~2 句中文要点摘要，开机即可快速浏览。
• 提取邮件中的截止时间和需要处理的事项，生成待办候选。`
		},
		"school-action": {
			badge: "学校事务",
			title: "🎓 创建学业待办",
			sub: "从导师反馈、论文审批和研讨会通知中提取明确行动项与截止时间。",
			body: `• 专门处理导师修改意见、论文提交、答辩申请、选课通知等学业事务。
• 提取明确的截止日期与任务内容，生成学业待办。
• 保留邮件原文入口，方便随时核对具体要求。`
		},
		"daily-action": {
			badge: "日常事务",
			title: "☕ 创建日常待办",
			sub: "从账单、银行通知和生活日程中提取需要处理的事项及截止时间。",
			body: `• 识别学费账单、银行通知、生活缴费等个人事务。
• 提取还款日或支付截止期，沉淀为日常待办。
• 与学业和求职待办集中管理，避免遗漏关键缴费。`
		},
		"llm-job": {
			badge: "求职信息提取",
			title: "🤖 提取公司、岗位和流程信息",
			sub: "识别邮件中的公司、岗位、笔试或面试环节、轮次、时间和面试链接。",
			body: `• 当邮件命中求职意图时，触发求职信息提取。
• 识别企业规范名称、应聘岗位、环节类型（投递/笔试/测评/面试/Offer/感谢信）、轮次、会议链接及作答截止时间。
• 提取结构化数据，供后续程序做记录匹配与状态更新。`
		},
		"job-match": {
			badge: "程序规则",
			title: "⚖️ 找到对应岗位，再更新进度",
			sub: "对照已有投递记录，匹配邮件对应的岗位并更新进度。",
			body: `• 对照投递数据库已有的记录更新求职进度：
  1. 数据库中无该企业记录 ➔ 自动新建投递档案；
  2. 唯一命中同公司同岗位 ➔ 自动追加到该公司的招聘时间线上，并把面试/笔试同步至待办列表；
  3. 同公司有多个岗位、邮件信息不足时 ➔ 生成待确认项，由用户手动选择归属，避免归错岗位；
  4. 收到感谢信或拒信 ➔ 标记该岗位已结束，不产生干扰待办。`
		},
		"llm-prep": {
			badge: "模型处理",
			title: "🤖 结合简历和岗位要求生成资料",
			sub: "由用户按需触发，结合所选简历、岗位 JD 和联网检索到的面试信息，生成面试准备资料。",
			body: `• 当岗位进入面试环节时，由用户在详情页主动触发，不盲目消耗调用配额。
• 严格以用户选定的真实简历为依据，结合岗位 JD 要求与联网检索的企业面经。
• 生成岗位考察要点、简历经历匹配和反问清单，辅助面试准备。`
		}
	};

	// 4. 架构图过滤器交互
	const filterBtns = document.querySelectorAll<HTMLButtonElement>(".dm-filter-btn");
	const pipeCards = document.querySelectorAll<HTMLElement>(".dm-card");

	filterBtns.forEach(btn => {
		btn.addEventListener("click", () => {
			filterBtns.forEach(b => b.classList.remove("active"));
			btn.classList.add("active");
			const filter = btn.getAttribute("data-filter") || "all";

			pipeCards.forEach(card => {
				const cat = card.getAttribute("data-cat") || "";
				if (filter === "all") {
					card.classList.remove("is-dimmed", "is-highlighted");
				} else if (filter === "llm") {
					if (cat.includes("llm")) {
						card.classList.remove("is-dimmed");
						card.classList.add("is-highlighted");
					} else {
						card.classList.add("is-dimmed");
						card.classList.remove("is-highlighted");
					}
				} else if (filter === "job") {
					if (cat.includes("job")) {
						card.classList.remove("is-dimmed");
						card.classList.add("is-highlighted");
					} else {
						card.classList.add("is-dimmed");
						card.classList.remove("is-highlighted");
					}
				} else if (filter === "school-daily") {
					if (cat.includes("school-daily")) {
						card.classList.remove("is-dimmed");
						card.classList.add("is-highlighted");
					} else {
						card.classList.add("is-dimmed");
						card.classList.remove("is-highlighted");
					}
				}
			});
		});
	});

	// 5. 侧边弹出详情卡片联动 (在点击卡片的侧面高亮弹出，拒绝下方占用)
	const pipelineContainer = document.getElementById("dm-pipeline-container");
	const sidePopover = document.getElementById("dm-side-popover");
	const popBadge = document.getElementById("dm-pop-badge");
	const popTitle = document.getElementById("dm-pop-title");
	const popSub = document.getElementById("dm-pop-sub");
	const popBody = document.getElementById("dm-pop-body");
	const popClose = document.getElementById("dm-pop-close");
	const popArrow = document.getElementById("dm-pop-arrow");

	function closeSidePopover() {
		if (!sidePopover) return;
		sidePopover.classList.remove("is-open");
		sidePopover.setAttribute("aria-hidden", "true");
		pipeCards.forEach(c => c.classList.remove("is-selected"));
	}

	function openSidePopover(card: HTMLElement, key: string) {
		const data = INSPECTOR_DATA[key];
		if (!data || !sidePopover || !pipelineContainer) return;

		pipeCards.forEach(c => c.classList.remove("is-selected"));
		card.classList.add("is-selected");

		if (popBadge) popBadge.textContent = data.badge;
		if (popTitle) popTitle.textContent = data.title;
		if (popSub) popSub.textContent = data.sub;
		if (popBody) popBody.innerHTML = data.body.split("\n").join("<br>");

		sidePopover.classList.add("is-open");
		sidePopover.setAttribute("aria-hidden", "false");

		// 定位计算：判断该卡片在容器中的相对位置，决定向右或向左弹出
		const containerRect = pipelineContainer.getBoundingClientRect();
		const cardRect = card.getBoundingClientRect();

		const cardTop = cardRect.top - containerRect.top;
		const cardLeft = cardRect.left - containerRect.left;
		const popoverWidth = Math.min(330, containerRect.width - 32);

		const isMobile = window.innerWidth <= 860;

		if (isMobile) {
			sidePopover.classList.remove("arrow-left", "arrow-right");
			sidePopover.style.left = "16px";
			sidePopover.style.right = "16px";
			sidePopover.style.width = "auto";
			sidePopover.style.top = cardTop + card.offsetHeight + 10 + "px";
			if (popArrow) popArrow.style.display = "none";
		} else {
			if (popArrow) popArrow.style.display = "block";
			let popLeft = 0;
			if (cardLeft < containerRect.width * 0.5) {
				// 偏左侧卡片：向右侧展开
				sidePopover.classList.remove("arrow-right");
				sidePopover.classList.add("arrow-left");
				popLeft = cardLeft + card.offsetWidth + 14;
				if (popLeft + popoverWidth > containerRect.width - 16) {
					popLeft = containerRect.width - popoverWidth - 16;
				}
			} else {
				// 偏右侧卡片：向左侧展开
				sidePopover.classList.remove("arrow-left");
				sidePopover.classList.add("arrow-right");
				popLeft = cardLeft - popoverWidth - 14;
				if (popLeft < 16) {
					popLeft = 16;
				}
			}
			sidePopover.style.left = popLeft + "px";
			sidePopover.style.right = "auto";
			sidePopover.style.width = popoverWidth + "px";

			// 垂直对齐：让浮窗尽量居中对应卡片垂直中心
			const popHeight = sidePopover.offsetHeight || 300;
			const cardCenterY = cardTop + card.offsetHeight / 2;
			let targetTop = cardCenterY - popHeight / 2;
			const maxTop = containerRect.height - popHeight - 16;
			if (targetTop > maxTop) targetTop = maxTop;
			if (targetTop < 16) targetTop = 16;
			sidePopover.style.top = targetTop + "px";

			// 箭头垂直精准指向卡片中心
			if (popArrow) {
				const arrowY = Math.max(18, Math.min(popHeight - 22, cardCenterY - targetTop - 6));
				popArrow.style.top = arrowY + "px";
			}
		}
	}

	pipeCards.forEach(card => {
		card.addEventListener("click", e => {
			e.stopPropagation();
			const key = card.getAttribute("data-key");
			if (!key) return;
			if (card.classList.contains("is-selected") && sidePopover?.classList.contains("is-open")) {
				closeSidePopover();
			} else {
				openSidePopover(card, key);
			}
		});
	});

	if (popClose) {
		popClose.addEventListener("click", e => {
			e.stopPropagation();
			closeSidePopover();
		});
	}

	if (sidePopover) {
		sidePopover.addEventListener("click", e => {
			e.stopPropagation();
		});
	}

	document.addEventListener("click", () => {
		closeSidePopover();
	});

	document.addEventListener("keydown", e => {
		if (e.key === "Escape") closeSidePopover();
	});

	// 6. 超清图片全屏 Lightbox 缩放 (移至 document.body 彻底突破父级层叠上下文)
	const lightboxOverlay = document.getElementById("dm-lightbox-overlay");
	const lightboxImg = document.getElementById("dm-lightbox-img") as HTMLImageElement | null;
	const lightboxClose = document.getElementById("dm-lightbox-close");
	const zoomBoxes = document.querySelectorAll<HTMLElement>("[data-lightbox]");

	if (lightboxOverlay && lightboxOverlay.parentElement !== document.body) {
		document.body.appendChild(lightboxOverlay);
	}

	function openLightbox(src: string) {
		if (!lightboxOverlay || !lightboxImg) return;
		lightboxImg.src = src;
		lightboxOverlay.classList.add("is-open");
		lightboxOverlay.setAttribute("aria-hidden", "false");
		document.body.style.overflow = "hidden";
	}

	function closeLightbox() {
		if (!lightboxOverlay) return;
		lightboxOverlay.classList.remove("is-open");
		lightboxOverlay.setAttribute("aria-hidden", "true");
		document.body.style.overflow = "";
	}

	zoomBoxes.forEach(box => {
		box.addEventListener("click", () => {
			const src = box.getAttribute("data-lightbox");
			if (src) openLightbox(src);
		});
	});

	if (lightboxClose) {
		lightboxClose.addEventListener("click", e => {
			e.stopPropagation();
			closeLightbox();
		});
	}

	if (lightboxOverlay) {
		lightboxOverlay.addEventListener("click", () => {
			closeLightbox();
		});
	}

	document.addEventListener("keydown", e => {
		if (e.key === "Escape" && lightboxOverlay?.classList.contains("is-open")) {
			closeLightbox();
		}
	});
</script>

