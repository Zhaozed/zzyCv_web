---
import PageLayout from "@/layouts/Base.astro";

import "@/styles/cortex-agent.css";
import "@/styles/cortex-toolhub.css";
import "@/styles/cortex-proactive.css";
import "@/styles/cortex-brief-evaluation.css";
import "@/styles/cortex-closing.css";

const initiatives = [
	{
		isCore: true,
		badge: "01 · 需求与产品形态",
		title: "使用需求",
		subtitle: "把分散的通知放到桌面上",
		context:
			"遇到的问题：论文和校招通知分散在不同邮箱，读完后还要手动记录截止时间。每天查看待办时，我希望打开电脑就能看到，不打开各个平台查阅。",
		action:
			"设计选择：采用「云端服务常驻监听 + 桌面端开机即览」的架构，确保电脑关机也能持续轮询整理邮件，开机直接呈现最新待办。",
		metrics: [
			{ val: "两类主要场景", label: "论文事务 · 校招求职" },
			{ val: "关机持续轮询", label: "开机即看 · 关机不漏通知" }
		],
		anchor: "#motivation"
	},
	{
		isCore: true,
		badge: "02 · 邮件处理流程",
		title: "处理思路",
		subtitle: "规则过滤，模型提取，程序更新记录",
		context:
			"遇到的问题：邮件中混有营销、广播和验证码，没有必要全部交给模型处理。同公司投递多个岗位时，还可能把通知归到错误的岗位。",
		action:
			"处理方式：先用规则过滤明显无关的邮件，再由模型提取类别、摘要和待办，最后按明确的匹配规则更新求职记录。",
		metrics: [
			{ val: "规则过滤", label: "减少无关邮件和模型调用" },
			{ val: "三类模型任务", label: "邮件整理 · 提取信息 · 准备面试" }
		],
		anchor: "#architecture"
	},
	{
		isCore: false,
		badge: "03 · 界面与功能",
		title: "功能落地",
		subtitle: "从查看邮件到处理待办、准备面试",
		context:
			"使用需求：除了知道收到什么消息，还需要清楚接下来做什么、什么时候做，以及每个岗位进行到了哪一步。",
		action:
			"界面设计：首页展示邮件摘要，待办看板管理截止时间，求职看板跟进岗位进度，详情页集中整理岗位信息和面试准备资料。",
		metrics: [
			{ val: "四个主要界面", label: "首页 / 待办 / 求职 / 岗位详情" },
			{ val: "个人使用", label: "日常管理与多场面试准备" }
		],
		anchor: "#features"
	}
];

const navigation = [
	{ id: "overview", num: "TOP", label: "项目概览" },
	{ id: "motivation", num: "01", label: "需求与产品形态" },
	{ id: "architecture", num: "02", label: "邮件处理流程" },
	{ id: "features", num: "03", label: "四个主要界面" },
	{ id: "retro", num: "04", label: "自用结果与复盘" }
];
---

<PageLayout
	meta={{
		title: "DayMate｜桌面 AI 助手：整理邮件、提取待办、跟进求职进度",
		description: "个人项目 · 独立产品设计与全栈开发 · 已开源 · Electron / SQLite"
	}}>
	<article class="cortex-case">
		<!-- 桌面端侧边目录 -->
		<aside class="ca-sidebar" aria-label="页内目录">
			<nav class="ca-nav" aria-label="项目章节导航">
				<p>本页目录</p>
				{
					navigation.map(item => (
						<a href={`#${item.id}`} aria-current={item.id === "overview" ? "location" : undefined}>
							<span>{item.num}</span>
							{item.label}
						</a>
					))
				}
			</nav>
		</aside>

		<!-- 移动端浮动目录 -->
		<details class="ca-mobile-toc">
			<summary>本页目录 <span aria-hidden="true">≡</span></summary>
			<nav aria-label="移动端项目章节导航">
				{
					navigation.map(item => (
						<a href={`#${item.id}`} aria-current={item.id === "overview" ? "location" : undefined}>
							<span>{item.num}</span>
							{item.label}
						</a>
					))
				}
			</nav>
		</details>

		<!-- Hero Section & Scorecard -->
		<header class="ca-hero" id="overview" data-case-section>
			<a class="ca-back" href="/projects/">← 返回项目经历</a>
			<p class="ca-eyebrow">
				<span aria-hidden="true"></span> 个人项目 · 独立产品设计与全栈开发 · 已开源
			</p>
			<h1>DayMate<span class="ca-title-dot" aria-hidden="true">.</span></h1>
			<p class="ca-subtitle">个人 AI 助手：整理邮件、提取待办、跟进求职进度</p>
			<p class="ca-intro ca-reading">
				写硕士论文和参加校招时，我需要在学校 Gmail、163
				邮箱和各大求职平台之间来回查看导师反馈、论文进度、测评和面试通知。每次读完，我还要判断是否需要回复、有没有截止时间，以及是否需要更新某个岗位的进度。我希望把这些重复的整理工作交给工具，并让结果出现在每天都能看到的地方。
			</p>
			<p class="ca-intro ca-reading" style="margin-top: 12px;">
				为此，我开发了
				DayMate。它汇总两个邮箱的邮件，过滤无关信息，生成中文摘要，并提取待办和截止时间。求职邮件会按公司和岗位更新应聘进度，无法明确归属的邮件则留待人工确认。打开电脑，就能看到重要邮件、待办事项和各个岗位的最新进展。
			</p>

			<!-- 职责与项目信息条 -->
			<div class="ca-role-strip ca-role-strip-balanced">
				<div class="ca-role-col">
					<strong>我的角色</strong>
					<span>独立完成产品设计与全栈开发</span>
				</div>
				<div class="ca-role-col">
					<strong>使用场景</strong>
					<span>论文事务管理与校招求职</span>
				</div>
				<div class="ca-role-col">
					<strong>技术栈</strong>
					<span>Electron · SQLite</span>
				</div>
			</div>

			<!-- 核心看点看板 (Scorecard 3 栏均布) -->
			<div class="ca-initiatives-wrap">
				<div class="ca-initiatives-head">
					<h3><span>PROJECT OVERVIEW</span>项目概览</h3>
					<h2 style="font-size: 20px; font-weight: 700; margin-top: 6px; color: var(--ca-text);">
						解决什么问题，做了哪些设计
					</h2>
					<p style="margin-top: 6px;">将邮件整理成摘要、待办和求职记录，集中展示在桌面上。</p>
				</div>
				<div class="ca-initiatives-grid dm-initiatives-3col">
					{
						initiatives.map(item => (
							<div class:list={["ca-init-card", { "is-core": item.isCore }]}>
								<div class="ca-init-top">
									<div class="ca-init-badge-row">
										<span class="ca-init-badge">{item.badge}</span>
									</div>
									<h4>{item.title}</h4>
									<p class="ca-init-subtitle">{item.subtitle}</p>
								</div>
								<div class="ca-init-body">
									<p
										class="ca-init-pain"
										set:html={item.context.replace(
											/^(遇到的问题：|使用需求：)/,
											"<strong>$1</strong>"
										)}
									/>
									<p
										class="ca-init-action"
										set:html={item.action.replace(
											/^(设计选择：|处理方式：|界面设计：)/,
											"<strong>$1</strong>"
										)}
									/>
								</div>
								<div class="ca-init-metrics">
									{item.metrics.map(m => (
										<div class="ca-init-m-col">
											<strong>{m.val}</strong>
											<span>{m.label}</span>
										</div>
									))}
								</div>
								<a class="ca-init-link" href={item.anchor}>
									查看详细内容 <span>↓</span>
								</a>
							</div>
						))
					}
				</div>
			</div>
		</header>

		<!-- 01 需求与产品形态 -->
		<section class="ca-section" id="motivation" data-case-section>
			<header class="ca-section-head">
				<p class="ca-kicker"><span>01</span> 需求与产品形态 · 为什么选择桌面端</p>
				<h2>读完邮件之后，还有很多整理工作</h2>
				<p class="ca-copy">
					导师的修改意见、答辩审批、48 小时内完成的测评和面试通知，分散在学校 Gmail 与 163
					邮箱里。每次读完，我还要判断是否需要回复、有没有截止时间，以及是否需要更新某个岗位的进度。
				</p>
				<p class="ca-copy" style="margin-top: 12px;">
					我希望把这些重复的整理工作交给工具，并让结果出现在每天都能看到的地方。为此，我比较了三种产品形式。
				</p>
			</header>

			<div class="ca-block ca-reveal">
				<div class="be-dilemma-grid">
					<div class="be-dilemma-card">
						<div class="be-dilemma-head">
							<span class="be-dilemma-tag">OPTION A</span>
							<h5 class="be-dilemma-title">对话式助手</h5>
						</div>
						<p class="be-dilemma-approach">
							<strong>使用方式：</strong>向 AI 提问，查询今日待办或邮件内容。
						</p>
						<p class="be-dilemma-pain">
							<strong>考虑：</strong
							>查看待办是一个每天重复的动作。如果每次都要打开对话、输入问题，使用步骤就多了一层。我更希望直接看到结果。
						</p>
						<div class="be-dilemma-verdict">未采用：查看待办前需要主动提问。</div>
					</div>

					<div class="be-dilemma-card">
						<div class="be-dilemma-head">
							<span class="be-dilemma-tag">OPTION B</span>
							<h5 class="be-dilemma-title">网页应用 (Web App)</h5>
						</div>
						<p class="be-dilemma-approach">
							<strong>使用方式：</strong>部署公网网页，在浏览器标签页中查看。
						</p>
						<p class="be-dilemma-pain">
							<strong>考虑：</strong
							>一方面，浏览器多标签极易被淹没，无法做到开机即见；另一方面，邮件包含论文评审、校招
							Offer 等高敏感隐私，公网 Web 隐私不受保护，且国内上线需要繁琐的域名 ICP 备案。
						</p>
						<div class="be-dilemma-verdict">
							未采用：主动打开摩擦大，且有公网隐私暴露与 ICP 备案成本。
						</div>
					</div>

					<div class="be-dilemma-card is-adopted">
						<div class="be-dilemma-head">
							<span class="be-dilemma-tag">OPTION C</span>
							<h5 class="be-dilemma-title">常驻桌面客户端 (C/S 架构)</h5>
						</div>
						<p class="be-dilemma-approach">
							<strong>使用方式：</strong>常驻 macOS 屏幕边缘，打开电脑即可查看最新邮件摘要与待办。
						</p>
						<p class="be-dilemma-pros">
							<strong>考虑：</strong
							>若采用纯本地程序，电脑关机或合盖休眠时轮询就会中断。因此架构设计为客户端与服务端解耦：由云端服务器常驻
							7×24 小时持续监听新邮件并完成模型处理；macOS
							客户端常驻桌面，开机直接呈现已整理好的最新要务，无需临时等待拉取。
						</p>
						<div class="be-dilemma-verdict">
							最终选择：电脑关机也能持续轮询处理，开机直接呈现最新要务。
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 02 邮件处理流程 -->
		<section class="ca-section" id="architecture" data-case-section>
			<header class="ca-section-head">
				<p class="ca-kicker"><span>02</span> 邮件处理流程 · 规则、模型与状态更新</p>
				<h2>先过滤无关邮件，再提取信息，最后更新记录</h2>
				<p class="ca-copy">
					不同邮件的格式和表达差异很大。规则适合过滤明确的营销内容和验证码，模型适合理解正文、提取信息，而岗位匹配和进度更新则交给程序处理。
				</p>
				<p class="ca-copy" style="margin-top: 12px;">
					DayMate 将这三部分分开：既减少不必要的模型调用，也让错误更容易被发现和修正。
				</p>
			</header>

			<!-- 交互式架构流水线 (3 阶段主处理管道 + 侧边弹出详情卡片) -->
			<div class="ca-block ca-reveal dm-pipeline-container" id="dm-pipeline-container">
				<div class="dm-pipeline-header">
					<div class="dm-pipe-titles">
						<h3><span>⚡</span> DayMate 邮件处理流程</h3>
						<p>规则过滤 → 邮件分类、摘要与待办提取 → 岗位匹配与进度更新</p>
					</div>
					<div class="dm-pipe-controls">
						<button class="dm-filter-btn active" data-filter="all">全部流程</button>
						<button class="dm-filter-btn" data-filter="job">👔 求职流程</button>
						<button class="dm-filter-btn" data-filter="school-daily">🎓 学校与日常</button>
						<button class="dm-filter-btn" data-filter="llm">🤖 仅模型调用</button>
					</div>
				</div>

				<!-- 简洁图例条：紧凑单行排列，去厚重白卡背景 -->
				<div class="dm-legend-strip">
					<span class="dm-legend-label">图例说明：</span>
					<span class="dm-legend-item">
						<span class="dm-badge badge-rule">⚡ 规则过滤</span>
						<span class="legend-desc">过滤无关</span>
					</span>
					<span class="dm-legend-item">
						<span class="dm-badge badge-llm">🤖 模型处理</span>
						<span class="legend-desc">摘要与待办</span>
					</span>
					<span class="dm-legend-item">
						<span class="dm-badge badge-logic">⚖️ 程序规则</span>
						<span class="legend-desc">匹配与更新</span>
					</span>
					<span class="dm-legend-item">
						<span class="dm-badge badge-warn">⚠️ 人工确认</span>
						<span class="legend-desc">歧义待确认</span>
					</span>
				</div>

				<!-- 3 阶段主处理管道 -->
				<div class="dm-pipeline-grid-3">
					<!-- Stage 1 -->
					<div class="dm-stage-col" data-stage="1">
						<div class="dm-stage-head">
							<span>01 / 邮件接入与过滤</span>
							<span class="dm-stage-tag">规则处理</span>
						</div>

						<div class="dm-card" data-cat="all job school-daily" data-key="mail-input">
							<div class="dm-card-top">
								<span class="dm-badge badge-rule">邮件接入</span>
								<span class="dm-card-click-tip">点击展开详情 ↗</span>
							</div>
							<div class="dm-card-title">📥 同步新邮件</div>
							<div class="dm-card-desc">
								通过 Gmail OAuth 2.0 和 163 IMAP 接入两个邮箱，每 3 分钟检查一次新邮件。
							</div>
						</div>

						<div class="dm-card" data-cat="all job school-daily" data-key="prefilter">
							<div class="dm-card-top">
								<span class="dm-badge badge-rule">⚡ 规则过滤</span>
								<span class="dm-card-click-tip">点击展开详情 ↗</span>
							</div>
							<div class="dm-card-title">🧹 过滤无关内容</div>
							<div class="dm-card-desc">用正则规则过滤营销推广、验证码和部分全员广播邮件。</div>
						</div>

						<div class="dm-card" data-cat="all" data-key="junk">
							<div class="dm-card-top">
								<span class="dm-badge badge-rule">过滤结果</span>
								<span class="dm-card-click-tip">点击展开详情 ↗</span>
							</div>
							<div class="dm-card-title">🗑️ 不再继续处理</div>
							<div class="dm-card-desc">命中过滤规则的邮件不调用模型，也不进入待办列表。</div>
						</div>
					</div>

					<!-- Stage 2 -->
					<div class="dm-stage-col" data-stage="2">
						<div class="dm-stage-head">
							<span>02 / 邮件分类与信息提取</span>
							<span class="dm-stage-tag">模型处理</span>
						</div>

						<div
							class="dm-card dm-card-primary"
							data-cat="all job school-daily llm"
							data-key="llm-inbox">
							<div class="dm-card-top">
								<span class="dm-badge badge-llm">🤖 邮件整理</span>
								<span class="dm-card-click-tip">点击展开详情 ↗</span>
							</div>
							<div class="dm-card-title">生成摘要，提取待办</div>
							<div class="dm-card-desc">
								一次模型调用完成三项工作：区分学校、日常和求职邮件；生成一到两句中文摘要；提取行动项和截止时间。
							</div>
						</div>

						<!-- 意图路由下游分流指引 -->
						<div class="dm-route-indicator">
							<div class="dm-route-head">按类别继续处理 →</div>
							<div class="dm-route-item"><span>🎓 学校事务</span> → 提取学业相关待办</div>
							<div class="dm-route-item"><span>☕ 日常事务</span> → 提取缴费、还款等事项</div>
							<div class="dm-route-item is-job">
								<span>👔 校招求职</span> → 提取岗位信息，更新求职记录
							</div>
						</div>
					</div>

					<!-- Stage 3 -->
					<div class="dm-stage-col" data-stage="3">
						<div class="dm-stage-head">
							<span>03 / 待办创建与求职进度更新</span>
							<span class="dm-stage-tag">业务处理</span>
						</div>

						<div class="dm-branches">
							<!-- 学校与日常分支 -->
							<div class="dm-branch-box" data-cat="all school-daily">
								<div class="dm-branch-title">🎓 学校事务与 ☕ 日常事务</div>

								<div class="dm-card" data-cat="all school-daily" data-key="school-action">
									<div class="dm-card-top">
										<span class="dm-badge badge-logic">学校事务</span>
										<span class="dm-card-click-tip">点击展开详情 ↗</span>
									</div>
									<div class="dm-card-title">🎓 创建学业待办</div>
									<div class="dm-card-desc">
										从导师反馈、论文审批和研讨会通知中提取明确的行动项。有截止时间时，一并记录到待办中。
									</div>
								</div>

								<div class="dm-card" data-cat="all school-daily" data-key="daily-action">
									<div class="dm-card-top">
										<span class="dm-badge badge-logic">日常事务</span>
										<span class="dm-card-click-tip">点击展开详情 ↗</span>
									</div>
									<div class="dm-card-title">☕ 创建日常待办</div>
									<div class="dm-card-desc">
										从账单、银行通知和生活日程中提取需要处理的事项及截止时间。
									</div>
								</div>
							</div>

							<!-- 求职分支 -->
							<div class="dm-branch-box dm-job-branch" data-cat="all job llm">
								<div class="dm-branch-title" style="color: #60a5fa;">👔 求职邮件处理</div>

								<div class="dm-card dm-card-primary" data-cat="all job llm" data-key="llm-job">
									<div class="dm-card-top">
