---
import LoopVideo from "@/components/LoopVideo.astro";
import PageLayout from "@/layouts/Base.astro";

import "@/styles/cortex-agent.css";
import "@/styles/cortex-toolhub.css";
import "@/styles/cortex-proactive.css";
import "@/styles/cortex-brief-evaluation.css";
import "@/styles/cortex-closing.css";

const initiatives = [
	{
		isCore: true,
		badge: "核心场景 01 · 为什么做",
		title: "从读邮件到推进行动",
		contextLabel: "核心痛点",
		context: "论文与校招通知分散在多处邮箱，读完还要手动记截止时间与应聘进展",
		action: "自动整理出可执行的待办，并按公司汇总求职状态，开机即清楚重点",
		metrics: [
			{ val: "双线场景", label: "硕士论文 + 校招求职" },
			{ val: "多源分散", label: "学校 Gmail · 国内 163" }
		],
		anchor: "#motivation"
	},
	{
		isCore: true,
		badge: "产品形态 02 · 客户端形态",
		title: "为什么选择桌面端：聊天 Bot、网页与桌面端",
		contextLabel: "场景考量",
		context: "查待办是开机即看的被动感知，对话式bot不适用该场景；网页端多标签页切换容易被忽略",
		action: "常驻 macOS 边缘随开随看，阿里云后端 24h 抓取入库，开机私有 API 快速同步",
		metrics: [
			{ val: "常驻桌面", label: "macOS 屏幕边缘随开随看" },
			{ val: "私有部署", label: "阿里云后端 · 免公网备案" }
		],
		anchor: "#desktop"
	},
	{
		isCore: false,
		badge: "核心功能 03 · 流程闭环",
		title: "待办提取、求职汇总与 HTML 面试资料",
		contextLabel: "核心功能",
		context: "从邮件提取事项与 DDL、求职信息按公司汇总进度，并按固定工作流生成面试资料",
		action: "待办直接进清单、不确定的邮件人工核对，并自动输出 HTML 面试资料",
		metrics: [
			{ val: "待办提取", label: "事项 / 来源 / 截止时间" },
			{ val: "求职进度", label: "按企业汇总测评与面试" },
			{ val: "HTML 资料", label: "公司调研与面经自动整理" }
		],
		anchor: "#features"
	},
	{
		isCore: false,
		badge: "实践验证 04 · 自用与心得",
		title: "自用验证与做个人 AI 工具的心得",
		contextLabel: "自用与开源",
		context: "已用于毕业求职期间日常整理，减少重复翻找；项目已开源至 GitHub",
		action: "选准高频任务把信息可靠转成行动，允许用户及时纠错才更容易真正用起来",
		metrics: [
			{ val: "6 场面试", label: "累计支撑求职实战备战" },
			{ val: "完全开源", label: "已开源至 GitHub 仓库" }
		],
		anchor: "#retro"
	}
];

const navigation = [
	{ id: "overview", num: "TOP", label: "项目概览" },
	{ id: "motivation", num: "01", label: "为什么做" },
	{ id: "desktop", num: "02", label: "为什么选择桌面端" },
	{ id: "features", num: "03", label: "核心功能" },
	{ id: "retro", num: "04", label: "自用结果与复盘" }
];
---

<PageLayout
	meta={{
		title: "DayMate｜桌面端 AI 待办与求职助手",
		description: "个人项目 · 独立设计与开发 · Electron / TypeScript / SQLite / 大模型 API · 已开源"
	}}>
	<article class="cortex-case">
		<!-- 桌面端侧边目录 -->
		<aside class="ca-sidebar" aria-label="页内目录">
			<nav class="ca-nav" aria-label="项目章节导航">
				<p>本页目录</p>
				{
					navigation.map(item => (
						<a href={`#${item.id}`} aria-current={item.id === "overview" ? "location" : undefined}>
							<span>{item.num}</span>
							{item.label}
						</a>
					))
				}
			</nav>
		</aside>

		<!-- 移动端浮动目录 -->
		<details class="ca-mobile-toc">
			<summary>本页目录 <span aria-hidden="true">≡</span></summary>
			<nav aria-label="移动端项目章节导航">
				{
					navigation.map(item => (
						<a href={`#${item.id}`} aria-current={item.id === "overview" ? "location" : undefined}>
							<span>{item.num}</span>
							{item.label}
						</a>
					))
				}
			</nav>
		</details>

		<!-- Hero Section & Scorecard -->
		<header class="ca-hero" id="overview" data-case-section>
			<a class="ca-back" href="/projects/">← 返回项目经历</a>
			<p class="ca-eyebrow"><span aria-hidden="true"></span> 个人项目 · 独立设计与开发 · 已开源</p>
			<h1>DayMate<span class="ca-title-dot" aria-hidden="true">.</span></h1>
			<p class="ca-subtitle">桌面端 AI 待办与求职助手</p>
			<p class="ca-intro ca-reading">
				写硕士论文和参加校招期间，导师反馈、论文节点、测评通知和面试安排分散在学校 Gmail、163
				邮箱及招聘平台。我的问题不是缺少一个地方读邮件，而是读完之后还要自己记下截止时间、下一步行动，以及每家公司的应聘进展。
			</p>
			<p class="ca-intro ca-reading" style="margin-top: 12px;">
				因此，我做了 DayMate：从邮件中整理出可执行的待办，按公司汇总求职状态，并自动生成 HTML
				格式的面试准备资料，让我打开电脑后能直接判断哪些事需要处理。项目现已开源至 GitHub。
			</p>

			<!-- 职责与项目信息条 -->
			<div class="ca-role-strip ca-role-strip-balanced">
				<div class="ca-role-col">
					<strong>我的角色</strong>
					<span>独立设计与全栈开发 (个人项目)</span>
				</div>
				<div class="ca-role-col">
					<strong>核心场景</strong>
					<span>硕士论文与校招求职事务整理</span>
				</div>
				<div class="ca-role-col">
					<strong>技术与部署</strong>
					<span>Electron · SQLite · 大模型 · 阿里云</span>
				</div>
			</div>

			<!-- 核心看点看板 (Scorecard) -->
			<div class="ca-initiatives-wrap ca-reveal">
				<div class="ca-initiatives-head">
					<h3><span>EXECUTIVE SCORECARD</span>项目规划与核心看点总览</h3>
					<p>
						围绕「待办提取」、「求职汇总」与「HTML 面试资料生成」，结合常驻桌面端形态与阿里云部署。
					</p>
				</div>
				<div class="ca-initiatives-grid">
					{
						initiatives.map(item => (
							<div class:list={["ca-init-card", "ca-reveal", { "is-core": item.isCore }]}>
								<div class="ca-init-top">
									<div class="ca-init-badge-row">
										<span class="ca-init-badge">{item.badge}</span>
										{item.isCore && <span class="ca-core-tag">核心刚需</span>}
									</div>
									<h4>{item.title}</h4>
								</div>
								<div class="ca-init-body">
									<p class="ca-init-pain">
										<strong>{item.contextLabel}：</strong>
										{item.context}
									</p>
									<p class="ca-init-action">
										<strong>做法与思路：</strong>
										{item.action}
									</p>
								</div>
								<div class="ca-init-metrics">
									{item.metrics.map(m => (
										<div class="ca-init-m-col">
											<strong>{m.val}</strong>
											<span>{m.label}</span>
										</div>
									))}
								</div>
								<a class="ca-init-link" href={item.anchor}>
									查看详细内容 <span>↓</span>
								</a>
							</div>
						))
					}
				</div>
			</div>

			<!-- 首页视频演示展示 -->
			<div class="ca-block ca-reveal" style="margin-top: 36px;">
				<LoopVideo
					label="DayMate 首页与待办模块演示"
					poster="/portfolio/daymate/home.png"
					src="/portfolio/daymate/home-demo.mp4"
				/>
				<p class="ca-caption">
					开机即见：从邮件中整理出的待办与求职进度并置一屏，打开电脑后直接判断哪些事需要处理。
				</p>
			</div>
		</header>

		<!-- 01 为什么做 -->
		<section class="ca-section" id="motivation" data-case-section>
			<header class="ca-section-head">
				<p class="ca-kicker"><span>01</span> 需求来源 · 为什么做</p>
				<h2>从读邮件到推进行动：信息分散与手动记录的负担</h2>
				<p class="ca-copy">
					写硕士论文和参加校招期间，导师反馈、论文节点、测评通知和面试安排分散在学校 Gmail、163
					邮箱及招聘平台。我的问题不是缺少一个地方读邮件，而是读完之后还要自己记下截止时间、下一步行动，以及每家公司的应聘进展。
				</p>
			</header>

			<div class="ca-block ca-reveal">
				<h3><span>信息分散的真实场景</span>多头输入带来的记忆与整理负荷</h3>
				<p class="ca-copy">当时各条线的信息入口彼此独立，且都伴随着明确的时间约束与后续动作：</p>
				<ul class="ca-observations" style="margin-top: 14px;">
					<li>
						<strong>海外学业（学校 Gmail）：</strong>
						导师论文修改意见、题目审核结果、毕业答辩申请节点与签证手续通知。全英文长邮件篇幅大，看漏一条就可能延误关键答辩节点。
					</li>
					<li>
						<strong>校招求职（163 邮箱 / 招聘平台）：</strong>
						投递企业的确认回执、48 小时限时 OT 在线测评链接、笔试考场安排与多轮面试邀约。发件主体五花八门，格式各不相同。
					</li>
					<li>
						<strong>日常事务：</strong>
						实习工作与日常团队协作任务同步。
					</li>
				</ul>
				<p class="ca-copy" style="margin-top: 14px;">
					读完邮件并不代表事情已经推进。如果每次都要自己手动去备忘录里记下“哪家公司需要在周三前做完测评”、“哪封邮件需要尽快回复导师修改意见”，一旦事情集中，就极易出现疏漏。
				</p>
				<div
					class="ca-card"
					style="margin-top: 18px; padding: 18px 22px; border-left: 3px solid var(--ca-accent); background: var(--ca-soft); border-radius: 0 8px 8px 0;">
					<strong style="color: var(--ca-text); font-size: 14px;">产品出发点：</strong>
					<p class="ca-copy" style="font-size: 14px; margin-top: 4px;">
						因此，我做了
						DayMate：从邮件中整理出可执行的待办，并按公司汇总求职状态，让我打开电脑后能直接判断哪些事需要处理。
					</p>
				</div>
			</div>
		</section>

		<!-- 02 为什么选择桌面端 -->
		<section class="ca-section" id="desktop" data-case-section>
			<header class="ca-section-head">
				<p class="ca-kicker"><span>02</span> 产品形态 · 为什么选择桌面端</p>
				<h2>聊天 Bot、网页端与桌面端的形态取舍</h2>
				<p class="ca-copy">
					这个工具服务于每天反复查看的个人工作流程。如果形态选错，每次查看都需要额外克服阻力，很难在真实生活里长期用下去。
				</p>
			</header>

			<div class="ca-block ca-reveal">
				<h3><span>三类形态权衡</span>对比聊天 Bot、网页端与常驻桌面端</h3>
				<p class="ca-copy">
					我对比过做聊天 Bot、网页端与桌面端三种不同的产品形态，最终做出了清晰的取舍：
				</p>
				<div class="be-dilemma-grid" style="margin-top: 16px;">
					<div class="be-dilemma-card">
						<div class="be-dilemma-head">
							<span class="be-dilemma-tag">OPTION A</span>
							<h5 class="be-dilemma-title">聊天 Bot (Chatbot)</h5>
						</div>
						<p class="be-dilemma-approach">
							<strong>交互方式：</strong>提供对话输入框，通过与 AI 问答获取今日要务与邮件信息
						</p>
						<p class="be-dilemma-pain">
							<strong>根本问题：</strong
							>查看今日待办和求职进展，本质上是「开机看一眼」的被动感知场景，根本没必要打字交互。每天坐下来还要想“该向
							AI 问什么”，完全不适用这种高频日常场景。
						</p>
						<div class="be-dilemma-verdict">放弃：不适用该场景，查待办根本没必要打字</div>
					</div>
					<div class="be-dilemma-card">
						<div class="be-dilemma-head">
							<span class="be-dilemma-tag">OPTION B</span>
							<h5 class="be-dilemma-title">网页端形态 (Web App)</h5>
						</div>
						<p class="be-dilemma-approach">
							<strong>交互方式：</strong>部署为公网 Web 网站，在浏览器中打开标签页使用
						</p>
						<p class="be-dilemma-pain">
							<strong>实际问题：</strong>除了高频切换繁琐，在国内服务器上线公网网站还需繁琐的域名
							ICP
							备案；更关键的是，邮件包含学业与求职敏感信息，暴露在公网网页端存在天然的安全与鉴权风险。
						</p>
						<div class="be-dilemma-verdict">放弃：繁琐备案 + 隐私暴露风险，完全没必要</div>
					</div>
					<div class="be-dilemma-card is-adopted">
						<div class="be-dilemma-head">
							<span class="be-dilemma-tag">OPTION C</span>
							<h5 class="be-dilemma-title">常驻桌面端 (DayMate)</h5>
						</div>
						<p class="be-dilemma-approach">
							<strong>交互方式：</strong>常驻在 macOS 屏幕边缘，开机即直观呈现待办与进度
						</p>
						<p class="be-dilemma-pros">
							<strong>核心价值：</strong>开机即见，被动感知；后端与数据库常驻阿里云 24h 持续抓取解析与入库，关机也不断联；通过私有 API 同步，免去公网 Web 备案与暴露风险。
						</p>
						<div class="be-dilemma-verdict">采用：随时可见，免去备案摩擦，保障隐私安全</div>
					</div>
				</div>
			</div>

			<div class="ca-block ca-reveal">
				<h3><span>架构澄清与安全边界</span>客户端形态、免备案与云端后端部署</h3>
				<p class="ca-copy">
					DayMate 是我每天都会查看的工具，所以我选择做成常驻在 macOS 屏幕边缘的桌面端。打开电脑就能看到待办和求职进度，不用再额外打开一个网页。
				</p>
				<p class="ca-copy" style="margin-top: 12px;">
					邮件处理则由部署在阿里云服务器上的后端负责：定时获取邮件、提取待办并保存求职记录。电脑关机时，后端仍可以继续处理；下次打开 DayMate，桌面端会获取更新后的结果。这样既满足了随手查看的使用习惯，也不需要为个人自用工具维护一个网页入口。
				</p>
			</div>

			<div class="ca-block ca-reveal">
				<h3><span>界面实景与设置</span>自用客户端界面</h3>
				<div class="dm-grid-2" style="margin-top: 16px;">
					<figure class="media-card">
						<img src="/portfolio/daymate/inbox.png" alt="邮件看板与求职状态整理" loading="lazy" />
						<figcaption class="ca-caption">
							邮件看板与求职整理：集中收拢各邮件源，提炼待办事项与推进状态
						</figcaption>
					</figure>
					<figure class="media-card">
						<img src="/portfolio/daymate/settings.png" alt="邮件凭据与配置设置" loading="lazy" />
						<figcaption class="ca-caption">
							配置与连接管理：客户端通过私有 API 与阿里云后端通信，连接云端数据库稳定同步最新待办与求职进展
						</figcaption>
					</figure>
				</div>
			</div>
		</section>

		<!-- 03 核心功能 -->
		<section class="ca-section" id="features" data-case-section>
			<header class="ca-section-head">
				<p class="ca-kicker"><span>03</span> 功能设计 · 核心功能</p>
				<h2>待办提取、求职汇总与 HTML 面试准备资料</h2>
				<p class="ca-copy">
					DayMate
					聚焦三项紧密衔接的核心功能：将相关邮件提取为待办、按公司汇总求职进展，以及自动化整理 HTML
					格式的面试准备资料。
				</p>
			</header>

			<!-- 功能一：邮件提取待办 -->
			<div class="ca-block ca-reveal">
				<h3><span>核心功能一：邮件提取待办</span>事项、来源与截止时间一目了然</h3>
				<p class="ca-copy">
					DayMate
					将相关邮件自动提取为待办，记录事项、来源和截止时间，直接推进到当日清单，无需手动复制备忘：
				</p>
				<ul class="ca-observations" style="margin-top: 14px;">
					<li>
						<strong>跟进 Dr. Rohani 论文审核反馈：</strong>【学校 Gmail · 学业 ·
						截止周五】核对论文修改意见并提交第二版草稿
					</li>
					<li>
						<strong>REMOS 会议系统背书确认：</strong>【学校 Gmail · 学业 · 8/16
						截止】联系导师确认会议系统摘要审核
					</li>
					<li>
						<strong>限时完成在线测评 (OT)：</strong>【163 邮箱 · 求职 · 48h
						截止】点击链接进入系统完成笔试测评
					</li>
				</ul>
			</div>

			<!-- 功能二：按公司汇总求职进展 -->
			<div class="ca-block ca-reveal">
				<h3><span>核心功能二：按公司汇总求职进度</span>看清每个机会走到了哪一步</h3>
				<p class="ca-copy">
					针对求职邮件，DayMate
					按公司汇总投递、测评、笔试和面试等进展，方便查看每个机会目前走到了哪一步：
				</p>
				<div class="flow" style="margin-top: 16px;">
					<div class="flow__step"><span>STEP 01</span><b>投递</b><small>回执确认与归档</small></div>
					<div class="flow__arrow">→</div>
					<div class="flow__step">
						<span>STEP 02</span><b>测评</b><small>OT 限时作答链接</small>
					</div>
					<div class="flow__arrow">→</div>
					<div class="flow__step"><span>STEP 03</span><b>笔试</b><small>考场时间与通知</small></div>
					<div class="flow__arrow">→</div>
					<div class="flow__step">
						<span>STEP 04</span><b>面试</b><small>多轮面试日程确认</small>
					</div>
