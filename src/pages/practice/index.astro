---
import PageHeading from "@/components/aria/PageHeading.astro";
import PostLoopCard from "@/components/aria/PostLoopCard.astro";
import PageLayout from "@/layouts/Base.astro";

const items = [
	{
		label: "01 / 个人项目 · 独立开发",
		title: "DayMate｜桌面端 AI 待办与求职助手",
		desc: "接入学校 Gmail 与 163 邮箱，自动整理邮件摘要、待办与求职进度，在 macOS 桌面上集中展示，支持个人日常事务管理与多场面试准备。",
		href: "/practice/daymate/",
	},
	{
		label: "02 / 业务流程自动化",
		title: "飞书多语种翻译工具",
		desc: "面向二十余张业务表格的多语种维护，将早期依赖个人的 Codex + CLI 流程重构为飞书机器人，通过交互卡片引导，支持自动检查、指定行号与新增语种三大入口。",
		href: "/practice/translator/",
	},
];
---

<PageLayout
	meta={{
		title: "专项实践 · 已合并至项目经历",
		description: "赵泽宇的 AI 产品实践项目已整合至「项目经历」页面。",
	}}
>
	<section class="relative z-20 mx-auto my-12 max-w-2xl px-7 lg:px-0">
		<div
			class="mb-6 rounded-lg border border-neutral-200 bg-neutral-50 p-4 dark:border-neutral-800 dark:bg-neutral-900/50"
		>
			<p class="text-sm font-medium text-neutral-800 dark:text-neutral-200">
				💡 实践项目现已全面整合入「项目经历」页面：
			</p>
			<a
				class="text-accent mt-2 inline-flex items-center text-sm font-semibold underline hover:opacity-80"
				href="/projects/#practices"
			>
				前往全新「项目经历」一览全貌 →
			</a>
		</div>

		<PageHeading
			title="专项实践"
			description="三项纵深实践分别验证了我的个人 Agent 产品 0→1、模型评测闭环与业务流程自动化交付能力。"
		/>

		<div class="my-8 flex w-full flex-col items-stretch gap-5">
			{
				items.map((item) => (
					<PostLoopCard
						title={item.title}
						description={item.desc}
						href={item.href}
						label={item.label}
					/>
				))
			}
		</div>
	</section>
</PageLayout>
