---
import PageHeading from "@/components/aria/PageHeading.astro";
import PostLoopCard from "@/components/aria/PostLoopCard.astro";
import PageLayout from "@/layouts/Base.astro";

const items = [
	{
		label: "01 / 个人产品 0→1",
		title: "DayMate｜macOS 个人工作代理",
		desc: "把非结构化邮件推进为必读清单、可跟进待办与求职档案，产品定义、全栈开发与评测闭环独立完成。",
		href: "/practice/daymate/",
		meta: "62 条回归用例 · 自用未上架",
	},
	{
		label: "02 / 原型与评审",
		title: "Cortex Agent 评审工作台",
		desc: "把语音、卡片和 Agent 决策编排成可播放的理想链路，让跨团队评审从读文档变成看体验。",
		href: "/practice/review-workbench/",
		meta: "支撑 10+ 个需求",
	},
	{
		label: "03 / 业务自动化",
		title: "飞书翻译机器人",
		desc: "识别表格增量内容，批量翻译并回填多语言列，同时维护术语一致性。",
		href: "/practice/translator/",
		meta: "8 语种 · 6万+ 文案",
	},
	{
		label: "04 / 模型评测",
		title: "多语种意图识别评测",
		desc: "从高置信错分样本出发，建立语料修正、全量回归和模型准入闭环。",
		href: "/practice/multilingual-evaluation/",
		meta: "4万+ 样本 / 轮",
	},
	{
		label: "05 / 工具沉淀",
		title: "Skills 与小插件",
		desc: "把重复的产品分析、工具接入与验收工作沉淀为可复用的 Agent 工作流。",
		href: "/practice/skills/",
		meta: "持续整理中",
	},
];
---

<PageLayout
	meta={{
		title: "其他实践",
		description: "赵泽宇的 AI 产品实践：DayMate 个人产品 0→1、评审工作台、翻译机器人、多语种评测与 Skills。",
	}}
>
	<section class="relative z-20 mx-auto my-12 max-w-2xl px-7 lg:px-0">
		<PageHeading
			title="其他实践"
			description="这五项实践分别验证了我的个人产品 0→1、原型评审、自动化交付、模型评测与工具沉淀能力。"
		/>

		<div class="my-8 flex w-full flex-col items-stretch gap-5">
			{items.map((item) => (
				<PostLoopCard
					title={item.title}
					description={item.desc}
					href={item.href}
					label={item.label}
					meta={item.meta}
				/>
			))}
		</div>
	</section>
</PageLayout>
