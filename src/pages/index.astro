---
import Button from "@/components/aria/Button.astro";
import PostLoopCard from "@/components/aria/PostLoopCard.astro";
import ProjectCard from "@/components/aria/ProjectCard.astro";
import Separator from "@/components/aria/Separator.astro";
import PageLayout from "@/layouts/Base.astro";

const practiceItems = [
	{
		label: "01 / 个人产品 0→1",
		title: "DayMate｜macOS 个人工作代理",
		desc: "把非结构化邮件推进为必读清单、可跟进待办与求职档案，独立完成产品定义、全栈开发与评测闭环。",
		href: "/practice/daymate/",
		meta: "62 条回归用例 · 自用未上架"
	},
	{
		label: "02 / 原型与评审",
		title: "Cortex Agent 评审工作台",
		desc: "把语音、卡片和 Agent 决策编排成可播放的理想链路，让跨团队评审从读文档变成看体验。",
		href: "/practice/review-workbench/",
		meta: "支撑 10+ 个需求"
	},
	{
		label: "03 / 业务自动化",
		title: "飞书翻译机器人",
		desc: "识别表格增量内容，批量翻译并回填多语言列，同时维护术语一致性。",
		href: "/practice/translator/",
		meta: "8 语种 · 6万+ 文案"
	},
	{
		label: "04 / 模型评测",
		title: "多语种意图识别评测",
		desc: "从高置信错分样本出发，建立语料修正、全量回归和模型准入闭环。",
		href: "/practice/multilingual-evaluation/",
		meta: "4万+ 样本 / 轮"
	},
	{
		label: "05 / 工具沉淀",
		title: "Skills 与小插件",
		desc: "把重复的产品分析、工具接入与验收工作沉淀为可复用的 Agent 工作流。",
		href: "/practice/skills/",
		meta: "持续整理中"
	}
];

---

<PageLayout
	meta={{
		title: "Home",
		description: "赵泽宇的 AI 产品经理作品集，关注 Agent 产品设计与质量评测。"
	}}>
	<div class="relative z-20 mx-auto mt-16 w-full max-w-4xl px-7 md:mt-24 lg:mt-32 xl:px-0">
		<div class="flex flex-col items-center md:flex-row">
			<div class="relative w-full md:w-1/2">
				<h1 class="mb-5 text-4xl leading-tight font-bold md:text-4xl lg:text-6xl dark:text-white">
					Hi, I'm Zeyu.
				</h1>
				<p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
					具备软件开发背景的 AI 产品经理，聚焦 Agent&nbsp;<br class="hidden lg:block" />产品设计与评测，推动
					AI 能力在真实业务场景落地。
				</p>
				<p class="mb-2 font-semibold text-neutral-800 dark:text-neutral-200">我能帮你搞定：</p>
				<ul
					class="list-inside list-disc space-y-[3px] py-2 text-sm text-neutral-500 dark:text-neutral-400">
					<li>Agent 产品架构与能力接入设计</li>
					<li>工具治理、记忆体系与主动服务</li>
					<li>评测集设计、LLM Judge 与 Bad Case 闭环</li>
					<li>高保真原型、评审与开发落地</li>
				</ul>
				<div class="mt-5 flex flex-wrap gap-3">
					<Button link="/projects/" text="查看精选项目" />
					<Button link="/portfolio/docs/zhaozeyu-resume.pdf" text="下载简历" variant="outline" />
				</div>
			</div>
			<div
				class="relative mt-10 hidden w-full justify-end md:mt-0 md:flex md:w-1/2 md:translate-y-4 md:pl-10 xl:translate-y-0">
				<div class="relative z-50 w-full">
					<div
						class="absolute top-0 bottom-0 z-40 h-16 w-16 -translate-x-6 -translate-y-1/2 rounded-full lg:top-auto lg:-translate-y-[330px]">
						<span
							class="relative z-20 flex h-full w-full items-center justify-center rounded-full border-8 border-white bg-neutral-100 text-2xl dark:border-neutral-950 dark:bg-neutral-900">
							<span
								class="flex h-full w-full items-center justify-center rounded-full border border-dashed border-neutral-300 bg-white dark:border-neutral-700 dark:bg-neutral-950"
								>👋</span
							>
						</span>
					</div>
					<div class="relative z-30 px-10">
						<img
							src="/portfolio/about/chatgpt-home.png"
							loading="eager"
							decoding="auto"
							class="relative z-30 mx-auto aspect-[993/1583] w-full md:max-w-md dark:-translate-y-0.5"
							alt="赵泽宇的 AI 形象照"
						/>
					</div>
					<div
						class="absolute right-0 bottom-0 z-20 h-full w-full translate-x-0 rounded-2xl border border-dashed border-neutral-300 bg-gradient-to-r from-white via-neutral-50 to-white lg:h-[420px] lg:-translate-y-px dark:border-neutral-700 dark:from-neutral-950 dark:via-black dark:to-neutral-950">
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="relative z-20 mx-auto max-w-4xl px-7 lg:px-0">
		<Separator text="精选项目" />

		<h2 class="text-2xl leading-10 font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
			精选项目
		</h2>
		<p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
			三个项目分别回答三个问题：Agent 能力怎么接进来并治理好、质量怎么被判定与准入、AI 怎么在真实业务里被人信任。
		</p>
		<div class="mt-7 grid w-full grid-cols-1 items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3">
			<ProjectCard
				name="Loona DeskMate"
				description="办公能力接入、ToolHub 工具治理与主动场景设计"
				image="/portfolio/covers/deskmate.svg"
				url="/projects/deskmate/"
				tags={["Tool Intake", "ToolHub", "Mental Offload"]}
			/>
			<ProjectCard
				name="Cortex-Eval"
				description="Agent 端到端评测与版本准入平台（0→1）"
				image="/portfolio/covers/cortex-eval.svg"
				url="/projects/cortex-eval/"
				tags={["Benchmark", "LLM Judge", "Release Gate"]}
			/>
			<ProjectCard
				name="ServiceAtlas"
				description="海外售后邮件 AI 助手：分诊、查证、拟稿与人工审核"
				image="/portfolio/covers/service-atlas.svg"
				url="/projects/service-atlas/"
				tags={["Agent Workflow", "RAG", "MCP"]}
			/>
		</div>

		<Separator text="其他实践" />

		<div class="flex w-full flex-col items-stretch gap-5">
			{
				practiceItems.map(item => (
					<PostLoopCard
						title={item.title}
						description={item.desc}
						href={item.href}
						label={item.label}
						meta={item.meta}
					/>
				))
			}
		</div>

		<Separator text="关于我" />

		<div class="flex flex-col items-start justify-start gap-8 py-4 md:flex-row md:space-x-12">
			<div class="w-full md:w-1/2">
				<h2
					class="text-2xl leading-10 font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
					产品判断之外，<br />我也负责把它做出来。
				</h2>
			</div>
			<div class="w-full md:w-1/2">
				<p class="text-base leading-8 text-neutral-600 dark:text-neutral-400">
					软件工程硕士，具备 AI
					产品设计、评测与开发落地经验。我习惯从真实任务定义成功标准，再用原型、代码和数据把判断验证清楚。
				</p>
				<div class="mt-6 flex flex-wrap gap-3">
					<Button link="/about/" text="关于我 →" />
					<Button link="mailto:18032098113@163.com" text="联系我" variant="outline" />
				</div>
			</div>
		</div>
	</div>

	<div class="pb-10"></div>
</PageLayout>
