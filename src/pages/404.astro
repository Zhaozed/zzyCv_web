---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Oops! It looks like this page is lost in space!",
	title: "Oops! You found a missing page!",
};
---

<PageLayout meta={meta}>
	<section class="relative z-20 mx-auto my-24 max-w-2xl px-7">
		<div class="text-center">
			<p class="eyebrow">404</p>
			<h1
				class="mt-2 text-4xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-5xl"
			>
				Oops something went wrong
			</h1>
			<p class="muted mt-4">Please use the navigation to find your way back</p>
		</div>
	</section>
</PageLayout>
