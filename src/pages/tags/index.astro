---
import PageHeading from "@/components/aria/PageHeading.astro";
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();
const allTags = getUniqueTagsWithCount(allPosts);

const meta = {
	description: "A list of all the topics I've written about in my posts",
	title: "All Tags",
};
---

<PageLayout meta={meta}>
	<section class="relative z-20 mx-auto my-12 max-w-2xl px-7 lg:px-0">
		<PageHeading title="Tags" description={meta.description} />
		<ul class="mt-8 space-y-3">
			{
				allTags.map(([tag, val]) => (
					<li class="flex items-baseline gap-2">
						<a
							class="text-sm font-semibold text-neutral-800 transition-colors duration-200 hover:text-neutral-950 hover:underline dark:text-neutral-200 dark:hover:text-white"
							href={`/tags/${tag}/`}
							title={`View posts with the tag: ${tag}`}
						>
							&#35;{tag}
						</a>
						<span class="text-xs text-neutral-400">
							- {val} Post{val > 1 && "s"}
						</span>
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>
