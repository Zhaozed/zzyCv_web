---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";
import PageHeading from "@/components/aria/PageHeading.astro";
import PostLoopCard from "@/components/aria/PostLoopCard.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort, getFormattedDate } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_POSTS_PER_PAGE = 10;
	const allPosts = await getAllPosts();
	const allPostsByDate = allPosts.sort(collectionDateSort);
	return paginate(allPostsByDate, {
		pageSize: MAX_POSTS_PER_PAGE,
	});
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
}

const { page } = Astro.props;

const meta = {
	description: "Read my collection of posts and the things that interest me",
	title: "Posts",
};

const cardProps = (p: CollectionEntry<"post">) => {
	const label = [p.data.pinned ? "PINNED" : null, p.data.draft ? "DRAFT" : null]
		.filter(Boolean)
		.join(" · ");
	return {
		title: p.data.title,
		description: p.data.description,
		href: `/posts/${p.id}/`,
		meta: `发布于 ${getFormattedDate(p.data.publishDate)}`,
		...(label ? { label } : {}),
	};
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← Previous Page",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "Next Page →",
			url: page.url.next,
		},
	}),
};
---

<PageLayout meta={meta}>
	<section class="relative z-20 mx-auto my-12 max-w-2xl px-7 lg:px-0">
		<div class="flex items-end justify-between gap-4">
			<PageHeading title={meta.title} />
			<a
				class="mb-2 shrink-0 text-neutral-400 transition-colors duration-200 hover:text-neutral-900 dark:hover:text-white"
				href="/rss.xml"
				target="_blank"
				aria-label="RSS feed"
			>
				<Icon aria-hidden="true" class="h-5 w-5" focusable="false" name="mdi:rss" />
			</a>
		</div>
		<div class="mt-8 flex flex-col gap-5">
			{page.data.map((p) => <PostLoopCard {...cardProps(p)} />)}
		</div>
		<Pagination {...paginationProps} />
	</section>
</PageLayout>
