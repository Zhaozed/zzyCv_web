---
import PageLayout from "@/layouts/Base.astro";

const allProjects = [
	{
		id: "01",
		name: "Cortex-Agent",
		category: "具身 Agent 运行时 · 实习项目",
		description:
			"Loona 桌面机器人的 Agent 运行时：负责 ToolHub 工具治理、办公能力接入与主动服务设计。",
		image: "/portfolio/covers/cortex-agent.svg",
		url: "/projects/cortex-agent/"
	},
	{
		id: "02",
		name: "Cortex-Eval",
		category: "自动化评测平台（0→1） · 实习项目",
		description:
			"Cortex-Agent 端到端评测与大版本验收平台：制定 6 维评测矩阵，搭建 Trace 白盒校验与回归发版硬门禁。",
		image: "/portfolio/covers/cortex-eval.svg",
		url: "/projects/cortex-eval/"
	},
	{
		id: "03",
		name: "DayMate｜邮件待办与求职进度工具",
		category: "Mental Offload · 个人项目",
		description:
			"写硕士论文和校招期间的自用工具：从邮件中整理可执行的待办，按公司汇总求职进度，并自动生成 HTML 面试准备资料。",
		image: "/portfolio/covers/daymate.svg",
		url: "/practice/daymate/"
	},
	{
		id: "04",
		name: "飞书多语种翻译工具",
		category: "团队提效工具（0→1） · 实习项目",
		description:
			"面向二十余张业务表格的多语种维护，将早期依赖个人的 Codex + CLI 流程重构为飞书机器人，通过交互卡片引导，支持自动检查、指定行号与新增语种三大入口。",
		image: "/portfolio/covers/translator.svg",
		url: "/practice/translator/"
	}
];
---

<PageLayout
	showBackground={false}
	meta={{
		title: "项目经历",
		description:
			"赵泽宇的 AI 产品项目经历：从 Cortex-Agent 具身运行时、Cortex-Eval 质量验证，到模型数据闭环与全栈工程实践。"
	}}>
	<div class="projects-page">
		<!-- 简洁页面标题 -->
		<header class="projects-heading">
			<h1 id="projects-title">项目经历</h1>
			<p>从具身 Agent 核心能力设计、评测验收体系，到全栈工程交付与个人场景落地。</p>
		</header>

		<!-- 从上往下平铺的单列项目流 -->
		<div class="projects-list">
			{
				allProjects.map((project, idx) => (
					<>
						{idx === 2 && (
							<div class="projects-divider" aria-hidden="true">
								<span class="divider-line" />
							</div>
						)}
						<a class="project-row-card" href={project.url} aria-label={`查看项目：${project.name}`}>
							<div class="row-info">
								<div class="row-meta">
									<span class="row-index">{project.id}</span>
									<span class="row-divider">/</span>
									<span class="row-category">{project.category}</span>
								</div>

								<h2 class="row-title">
									<span>{project.name}</span>
									<span class="row-arrow" aria-hidden="true">
										→
									</span>
								</h2>

								<p class="row-desc">{project.description}</p>
							</div>

							<div class="row-media">
								<img
									src={project.image}
									alt={project.name}
									width="1200"
									height="675"
									loading="lazy"
									decoding="async"
								/>
							</div>
						</a>
					</>
				))
			}
		</div>
	</div>
</PageLayout>

<style>
	.projects-page {
		--projects-muted: #737373;
		--projects-accent: #b43a30;
		--projects-line: rgba(0, 0, 0, 0.08);
		--projects-card-bg: rgba(0, 0, 0, 0.015);
		--projects-card-border: rgba(0, 0, 0, 0.08);
		--projects-pill-bg: rgba(0, 0, 0, 0.04);
		max-width: 960px;
		margin: 0 auto;
		padding: 48px 24px 80px;
	}

	:global([data-theme="dark"]) .projects-page {
		--projects-muted: #a3a3a3;
		--projects-accent: #f09a8f;
		--projects-line: rgba(255, 255, 255, 0.1);
		--projects-card-bg: rgba(255, 255, 255, 0.025);
		--projects-card-border: rgba(255, 255, 255, 0.08);
		--projects-pill-bg: rgba(255, 255, 255, 0.05);
	}

	.projects-heading {
		margin-bottom: 40px;
	}

	.projects-heading h1 {
		margin: 0;
		font-size: clamp(28px, 3.5vw, 36px);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1.25;
	}

	.projects-heading p {
		margin: 12px 0 0;
		color: var(--projects-muted);
		font-size: 15px;
		line-height: 1.7;
		max-width: 600px;
	}

	/* 从上往下直铺的单列项目流 */
	.projects-list {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	/* 核心与探索之间的分割下划线 */
	.projects-divider {
		padding: 12px 0;
		display: flex;
		align-items: center;
	}

	.divider-line {
		width: 100%;
		height: 1px;
		background: var(--projects-line);
		border-radius: 9999px;
	}

	.project-row-card {
		display: flex;
		align-items: center;
		padding: 24px;
		border-radius: 16px;
		background: var(--projects-card-bg);
		border: 1px solid var(--projects-card-border);
		color: inherit;
		text-decoration: none;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		position: relative;
		overflow: hidden;
	}

	.row-info {
		flex: 1 1 56%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-right: 28px;
		min-width: 0;
	}

	.row-meta {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		margin-bottom: 10px;
	}

	.row-index {
		color: var(--projects-accent);
	}

	.row-divider {
		color: var(--projects-muted);
		opacity: 0.5;
	}

	.row-category {
		color: var(--projects-muted);
	}

	.row-title {
		margin: 0;
		font-size: 21px;
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.35;
		display: flex;
		align-items: center;
		gap: 8px;
		transition: color 0.2s ease;
	}

	.row-arrow {
		color: var(--projects-muted);
		font-size: 20px;
		transition:
			transform 0.2s ease,
			color 0.2s ease;
	}

	.row-desc {
		margin: 10px 0 0;
		color: var(--projects-muted);
		font-size: 14px;
		line-height: 1.75;
	}

	.row-media {
		flex: 0 0 44%;
		border-radius: 10px;
		overflow: hidden;
		border: 1px solid var(--projects-card-border);
		background: var(--projects-pill-bg);
		aspect-ratio: 16 / 9;
	}

	.row-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.35s ease;
	}

	/* 悬浮交互 */
	.project-row-card:hover {
		border-color: var(--projects-accent);
		transform: translateY(-2px);
		box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.08);
	}

	:global([data-theme="dark"]) .project-row-card:hover {
		box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.3);
	}

	.project-row-card:hover .row-title,
	.project-row-card:hover .row-arrow {
		color: var(--projects-accent);
	}

	.project-row-card:hover .row-arrow {
		transform: translateX(4px);
	}

	.project-row-card:hover .row-media img {
		transform: scale(1.03);
	}

	/* 响应式：移动端与窄屏自适应 */
	@media (max-width: 820px) {
		.projects-page {
			padding: 32px 18px 60px;
		}

		.projects-heading {
			margin-bottom: 28px;
		}

		.project-row-card {
			flex-direction: column-reverse;
			padding: 20px;
			gap: 16px;
		}

		.row-info {
			padding-right: 0;
			width: 100%;
		}

		.row-media {
			width: 100%;
			flex: auto;
		}

		.row-title {
			font-size: 19px;
		}
	}
</style>
