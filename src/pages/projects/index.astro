---
import PageHeading from "@/components/aria/PageHeading.astro";
import ProjectCard from "@/components/aria/ProjectCard.astro";
import PageLayout from "@/layouts/Base.astro";

const projects = [
	{
		name: "Loona DeskMate",
		description: "办公能力接入、ToolHub 工具治理与主动场景设计",
		image: "/portfolio/covers/deskmate.svg",
		url: "/projects/deskmate/",
		tags: ["Tool Intake", "ToolHub", "Mental Offload"],
	},
	{
		name: "Cortex-Eval",
		description: "Agent 端到端评测与版本准入平台（0→1）",
		image: "/portfolio/covers/cortex-eval.svg",
		url: "/projects/cortex-eval/",
		tags: ["Benchmark", "LLM Judge", "Release Gate"],
	},
	{
		name: "ServiceAtlas",
		description: "海外售后邮件 AI 助手：分诊、查证、拟稿与人工审核",
		image: "/portfolio/covers/service-atlas.svg",
		url: "/projects/service-atlas/",
		tags: ["Agent Workflow", "RAG", "MCP"],
	},
];

const overview = [
	{
		name: "Loona DeskMate｜桌面具身 Agent",
		role: "AI 产品经理（实习）· 能力接入 / 工具治理 / 场景设计",
		stage: "已上线（Kickstarter 众筹产品）",
		result: "Planner 输入 Token ≈40% ↓；关键事项覆盖率 60% → 87%",
		href: "/projects/deskmate/",
	},
	{
		name: "Cortex-Eval｜e2e 评测与版本准入平台",
		role: "产品负责人（0→1）· 信息架构与评测工作流",
		stage: "已支撑 3 次版本验收",
		result: "9 类场景 213 个 Case；单轮走查周期 ≈60% ↓",
		href: "/projects/cortex-eval/",
	},
	{
		name: "ServiceAtlas｜海外售后邮件 AI 助手",
		role: "产品负责人（0→1）· 需求 / 方案 / 评测与迭代",
		stage: "小范围试点",
		result: "草稿直接采纳率 80%；人均工单处理效率 40% ↑",
		href: "/projects/service-atlas/",
	},
];
---

<PageLayout
	meta={{
		title: "精选项目",
		description:
			"赵泽宇的 AI 产品项目案例：Loona DeskMate 工具治理、Cortex-Eval 评测与版本准入、ServiceAtlas 海外售后邮件 AI 助手。",
	}}
>
	<section class="relative z-20 mx-auto my-12 max-w-4xl px-7 lg:px-0">
		<div class="max-w-2xl">
			<PageHeading
				title="精选项目"
				description="三个来自真实业务的项目，分别回答三个问题：Agent 能力怎么接进来并治理好、质量怎么被判定与准入、AI 怎么在业务里被人信任。每篇都按「问题 → 取舍 → 验证」展开，不是功能清单。"
			/>
		</div>

		<div class="my-8 grid w-full grid-cols-1 items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				projects.map((item) => (
					<ProjectCard
						name={item.name}
						description={item.description}
						image={item.image}
						url={item.url}
						tags={item.tags}
					/>
				))
			}
		</div>

		<table class="data-table">
			<caption>三个项目一览 · 角色 / 阶段 / 核心结果</caption>
			<thead>
				<tr>
					<th>项目</th>
					<th>我的角色</th>
					<th>阶段</th>
					<th>核心结果</th>
				</tr>
			</thead>
			<tbody>
				{
					overview.map((item) => (
						<tr>
							<td>
								<a class="cactus-link" href={item.href}>
									{item.name}
								</a>
							</td>
							<td>{item.role}</td>
							<td>{item.stage}</td>
							<td class="num">{item.result}</td>
						</tr>
					))
				}
			</tbody>
		</table>

		<p class="muted mt-8 text-sm leading-7">
			指标口径以各案例页内说明为准，业务信息已脱敏。DayMate、评审工作台、翻译机器人、多语种评测与 Skills
			等个人实践见<a class="cactus-link" href="/practice/">其他实践</a>。
		</p>
	</section>
</PageLayout>
