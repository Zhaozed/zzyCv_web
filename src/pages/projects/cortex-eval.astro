			},
			{
				label: "MCP 源码定位联动",
				desc: "研发在 IDE 中通过 MCP 协议直接读取 Trace 失败证据链，直达报错业务代码行。"
			},
			{
				label: "缺陷闭环流水线",
				desc: "阻塞缺陷自动提单并关联复现 Trace，修复合流后触发针对性单 Case 定向复测。"
			}
		],
		fileName: "attribution-tree.txt",
		code: `// 5-Layer Failure Attribution (五层责任归因体系)
┌─ [L1 Router] 未识别为 existing 任务 -> 路由偏离 (阻断)
├─ [L2 Tool]   死循环 / 绕过二次确认卡 -> 工具编排缺陷 (阻断)
├─ [L3 Model]  脱离工具返回事实脑补 -> 事实幻觉 (阻断)
├─ [L4 TTS]    暴露调试字符或内部ID -> 发声格式违规 (警告)
└─ [L5 A2UI]   卡片字段缺失或错位 -> 协议渲染错误 (警告)`,
		pmInsight:
			"机器发现缺陷后不只给个冷冰冰的分数，而是自动定性归因。评测系统不是考卷打分器，而是产研交付流水线上的加速器。"
	},
	{
		id: "gate",
		group: "loop",
		step: "GATE",
		monoTag: "GOVERNANCE · RELEASE GATE",
		name: "准入门禁",
		badge: "发版一票否决",
		title: "版本准入门禁 · Release Gate",
		role: "连接评测体系与发版交付的硬卡点。落实 Regression-Free（核心能力无退化）原则，严格守死核心场景底线。",
		subsystems: [
			{
				label: "核心链路 100% 准入",
				desc: "高频基础办公场景（查改日程、发信、待办）必须 100% 通过方可进入发版队列。"
			},
			{
				label: "阻塞级缺陷 0 容忍",
				desc: "高危写操作绕过确认、工具死循环、状态串线等阻塞级 Agent 缺陷坚决一票否决。"
			},
			{
				label: "结论可解释可复现",
				desc: "所有失败 Case 必须挂载完整白盒 Trace 证据链，杜绝无法复现的玄学假阴性。"
			},
			{
				label: "基线自动化对比",
				desc: "新版本各项维度通过率不得低于历史基线，严防局部逻辑优化造成逆向退化。"
			}
		],
		fileName: "release-gate.log",
		code: `// Release Gate 自动化准入决断报表
[CRITICAL] 核心场景通过率: 100% (目标 100%)       -> PASS
[BLOCKER]  阻塞级缺陷数量: 0 项 (目标 0 项)        -> PASS
[WARN]     体验级建议缺陷: 2 项 (允许带缺陷发布)   -> WARN
[AUDIT]    异常 Trace 复现率: 100% (可解释可复现)   -> PASS
────────────────────────────────────────────────────────
>>> RELEASE VERDICT: GO (准予合流发布灰度版本)`,
		pmInsight:
			"发版门禁建立在真实风险之上。任何可能导致用户真实数据被误篡改或安全穿帮的缺陷，哪怕整体平均分上涨，也绝不妥协放行。"
	},
	{
		id: "pool",
		group: "loop",
		step: "LOOP",
		monoTag: "FLYWHEEL · REGRESSION POOL",
		name: "回归资产池",
		badge: "防退化资产飞轮",
		title: "防退化回归资产池 · Regression Pool",
		role: "被拦截修复的线上 Bad Case 与阻塞缺陷自动沉淀为永久回归用例，形成“发现缺陷 → 修复复测 → 沉淀资产 → 持续防护”的正向闭环。",
		subsystems: [
			{
				label: "Bad Case 自动沉淀",
				desc: "发版拦截或线上漏网的典型缺陷修复后，一键转为回归用例并锁定期望断言。"
			},
			{
				label: "场景变体用例衍生",
				desc: "基于已修复缺陷，通过泛化槽位自动扩展同类入参的对抗性边界 Case。"
			},
			{
				label: "资产版本化归档",
				desc: "用例集随 Agent 能力版本同步演进，形成持续增殖且可回溯的质量资产底座。"
			},
			{
				label: "日常 CI 持续守护",
				desc: "回归资产池直接挂载至主干持续集成流水线，永不中断地防护核心能力。"
			}
		],
		fileName: "quality-flywheel.txt",
		code: `// 防退化正向资产飞轮 (Quality Flywheel)
[发版前拦截缺陷] ──> [研发修复归档] ──> [提取 Trace 真实帧]
       ▲                                         │
       │                                         ▼
[CI/CD日常守护网] <── [自动挂载回归集] <── [脱敏结构化为Case]`,
		pmInsight:
			"每一次线上事故或发版拦截，都是用例资产进化的最好养料。修完即扔是最大的浪费，脱敏固化为自动化资产才能让系统越跑越稳。"
	}
];

const reflections = [
	{
		title: "评测分流设计：把业务预期转化为可验证的契约",
		paragraphs: [
			"Agent 的执行同时包含确定性约束与开放性表达。统一采用文本匹配，会误杀合理回答；全部交给模型打分，又可能让安全违规被整体高分掩盖。",
			"因此，我依据<strong>可验证性选择裁判，依据风险等级设置门槛</strong>：对接口 Schema、工具入参、敏感写操作确认等明确约束，采用代码断言；对事实一致性、信息完整性与口播自然度，采用分维度 Rubric 和模型核验，并通过人工抽检校准。安全红线独立验收，不被其他维度的高分抵消。",
			"以日程改期为例，“对象是否正确、授权是否满足、修改是否成功、回复是否准确”需要分别判定。拆开这些维度，才能区分问题出在决策、执行还是表达，并明确哪些失败必须阻断发版。",
			"<strong>我的认知：</strong>评测设计的核心，是把业务预期转化为可验证的契约——底线有硬约束，表达有合理容差，失败有明确归因。"
		]
	},
	{
		title: "评测集建设：用结构化方法构建，用状态治理保证可信",
		paragraphs: [
			"高价值测试集需要同时解决三个问题：测什么、如何快速构建、如何保证结果不失真。",
			"<strong>选题看决策分支。</strong>按照“业务任务 × 风险等级 × 关键状态”建立覆盖矩阵。日程改期中的同名目标、确认状态、时间冲突与工具失败，都会改变 Agent 的决策要求，应优先覆盖；表达变体则用于补充验证语言鲁棒性。",
			"<strong>提效靠用例结构复用。</strong>可复用的构建路径是：从真实请求与历史失败中提炼种子用例，明确输入、初始状态、预期结果与判分依据，再借助模板或 LLM 扩展。人工集中审核业务预期和关键边界，通过小批试跑校准后入库。先验证种子用例，再扩大规模，才能同时控制构建成本与用例质量。",
			"<strong>可信靠执行前提一致。</strong>在同 UID 共享可变状态、缺乏充分隔离的条件下，相关用例串行执行；独立用例执行前恢复声明的初始状态，多轮用例内部保留连续上下文，避免残留会话、记忆或日程污染结果。",
			"<strong>我的认知：</strong>评测集的价值取决于有效覆盖与可重复验证。先确认用例、裁判和环境有效，再判断 Agent 能力，评测结果才能可靠地指导迭代与版本准入。"
		]
	}
];
---

<PageLayout
	meta={{
		title: "Cortex-Eval · Agent 评测与版本验收平台",
		description:
			"可以科技 Cortex-Agent 评测与版本验收平台：从 0 到 1 搭建自动化评测体系，结合确定性代码断言、JEV 结构化核验与 Trace 归因诊断，用客观证据支撑大版本发布准入决策。"
	}}>
	<article class="cortex-case ce-case">
		<!-- 桌面端侧边目录 -->
		<aside class="ca-sidebar" aria-label="页内目录">
			<nav class="ca-nav" aria-label="项目章节导航">
				<p>本页目录</p>
				{
					navigation.map((item, i) => (
						<a href={`#${item.id}`} aria-current={i === 0 ? "location" : undefined}>
							<span>{i === 0 ? "TOP" : `0${i}`}</span>
							{item.label}
						</a>
					))
				}
			</nav>
		</aside>

		<!-- 移动端浮动目录 -->
		<details class="ca-mobile-toc">
			<summary>本页目录 <span aria-hidden="true">≡</span></summary>
			<nav aria-label="移动端项目章节导航">
				{
					navigation.map((item, i) => (
						<a href={`#${item.id}`} aria-current={i === 0 ? "location" : undefined}>
							<span>{i === 0 ? "TOP" : `0${i}`}</span>
							{item.label}
						</a>
					))
				}
			</nav>
		</details>

		<!-- Hero & 概览 -->
		<header class="ca-hero" id="overview" data-case-section>
			<a class="ca-back" href="/projects/">← 返回精选项目</a>
			<p class="ca-eyebrow"><span aria-hidden="true"></span> 可以科技 KEYi · AI 产品经理实习项目</p>
			<h1>Cortex-Eval<span class="ca-title-dot" aria-hidden="true">.</span></h1>
			<p class="ca-subtitle">Cortex-Agent 端到端评测与版本验收平台</p>
			<p class="ca-intro ca-reading">
				随着 Cortex-Agent 持续接入日程、邮件等办公工具，多轮交互与复杂工具编排让质量保障高度依赖手工走查，单轮回归耗时长达 1 天。我从 0 到 1 负责配套评测与验收平台的体系设计与落地：拆解 6 维评测标准与 Case 规范，搭建自动化批跑、Trace 白盒校验与归因诊断能力。平台落地后作为大版本发版硬门禁，<strong>将单轮走查回归周期从 1 天压缩至 2~3 小时（缩短约 60%）</strong>，发版前累计拦截 5 项阻塞级 Agent 缺陷，支撑了 3 轮大版本的稳定发布。
			</p>

			<div class="ca-role-strip">
				<div class="ca-role-col">
					<strong>我的角色</strong>
					<span>AI 产品经理（实习）· 负责评测体系设计、Case 规范制定与平台落地</span>
				</div>
				<div class="ca-role-col">
					<strong>项目周期</strong>
					<span>2026.06 — 2026.08</span>
				</div>
				<div class="ca-role-col">
					<strong>协作团队</strong>
					<span>产品负责人、Agent 研发、测试</span>
				</div>
			</div>
		</header>

		<!-- 平台实操演示录屏 -->
		<section class="ca-experience" id="demo" aria-label="平台演示">
			<figure class="ca-video">
				<div class="ca-video-heading">
					<span>平台操作实录</span>
					<span>29.5 秒 · 静音 · 真实版本验收运行记录</span>
				</div>
				<video
					controls
					playsinline
					preload="none"
					poster="/portfolio/cortex/cortex-eval-poster.png"
					aria-label="Cortex-Eval 平台操作演示，展示批跑、Case 查看、Trace 证据与版本对比">
					<source src="/portfolio/cortex/cortex-eval-29.5s.mp4" type="video/mp4" />
				</video>
				<figcaption>
					批跑结果总览 → 穿透失败 Case → 查看字段级规则与 Trace 执行证据 → 修复后同 Case
					版本对比验证。
				</figcaption>
			</figure>
			<div class="ca-actions" style="margin-top: 14px;">
				<a
					class="ca-text-link"
					href="https://github.com/Zhaozed/cortex-eval"
					target="_blank"
					rel="noopener noreferrer">
					查看 GitHub 开源仓库 (前端 / 后端 / 评测流) ↗
				</a>
			</div>
		</section>

		<!-- 01 问题与标准 -->
		<section class="ca-section" id="problem" data-case-section aria-labelledby="problem-title">
			<header class="ca-section-head">
				<p class="ca-kicker"><span>01</span> 问题与标准</p>
				<h2 id="problem-title">为什么做、怎么算做对：三个痛点与对应的建设方案</h2>
				<p class="ca-copy">
					评测不是为了跑出好看的分数，而是让每次能力接入、提示词调优与版本发布，都有可复查的质量依据。
				</p>
			</header>

			<!-- 痛点与对策 -->
			<div class="ca-block">
				<h3><span>业务痛点</span>人工走查的三个瓶颈，与对应的平台方案</h3>
				<div class="cl-sop-grid" style="margin-top: 16px;">
					{
						painPoints.map(item => (
							<div class="cl-sop-card ca-reveal">
								<div class="cl-sop-top">
									<span class="cl-sop-num">{item.num}</span>
									<span class="cl-sop-tag">{item.tag}</span>
								</div>
								<h4>{item.title}</h4>
								<p>{item.pain}</p>
								<p style="margin-top: 10px;">
									<strong style="color: var(--ca-text);">对策：</strong>
									{item.solution}
								</p>
							</div>
						))
					}
				</div>
			</div>

			<!-- 6 维评测矩阵 -->
			<div class="ca-block" id="dim-inspector-section">
				<div class="ce-dim-header-row">
					<div class="ce-dim-title-group">
						<span class="ce-dim-kicker">标准设计</span>
						<h3 class="ce-dim-heading">覆盖 Agent 交互全生命周期的 6 维评测矩阵</h3>
					</div>
					<div class="ce-view-switcher" role="tablist" aria-label="评测矩阵视图切换">
						<button
							type="button"
							class="ce-view-btn is-active"
							data-view="radar"
							aria-selected="true"
							aria-label="切换为六维雷达图视图">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"></polygon></svg>
							六维雷达
						</button>
						<button
							type="button"
							class="ce-view-btn"
							data-view="grid"
							aria-selected="false"
							aria-label="切换为平铺矩阵视图">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
							平铺矩阵
						</button>
					</div>
				</div>
				<p class="ca-copy">
					每个维度的关注点不同，不强求每条 Case 机械检查全部维度，而是按场景风险按需挂载。
				</p>

				<!-- 交互式六维雷达视窗 (Radar Inspector) -->
				<div class="ce-radar-inspector" data-view-target="radar">
					<div class="ce-radar-layout">
						<!-- 左侧：雷达图交互盘 -->
						<div class="ce-radar-visual-col">
							<svg class="ce-radar-svg" viewBox="0 0 420 360" role="img" aria-label="Agent 6 维评测指标雷达图">
								<defs>
									<radialGradient id="ceRadarGlow" cx="50%" cy="50%" r="50%">
										<stop offset="0%" stop-color="var(--ca-accent)" stop-opacity="0.32" />
										<stop offset="100%" stop-color="var(--ca-accent)" stop-opacity="0.06" />
									</radialGradient>
								</defs>

								<!-- 同心正六边形网格 -->
								{
									radarGridHexagons.map(pts => (
										<polygon points={pts} class="ce-radar-grid-polygon" />
									))
								}

								<!-- 中心至顶点辐射轴线 -->
								{
									radarVertices.map((v, i) => (
										<line
											x1={radarCenter.x}
											y1={radarCenter.y}
											x2={v.x}
											y2={v.y}
											class:list={["ce-radar-spoke", { "is-active": i === 0 }]}
											data-spoke-index={i}
										/>
									))
								}

								<!-- 雷达数据覆盖区域 -->
								<polygon points={radarDataPolygonPoints} class="ce-radar-data-area" fill="url(#ceRadarGlow)" />

								<!-- 六个交互节点与文字标签 -->
								{
									radarVertices.map((v, i) => (
										<g
											class:list={["ce-radar-node", { "is-active": i === 0 }]}
											data-node-index={i}
											tabindex="0"
											role="button"
											aria-label={`查看维度 ${v.code} ${v.title}`}>
											<circle cx={v.x} cy={v.y} r="18" class="ce-radar-node-halo" />
											<circle cx={v.x} cy={v.y} r="6" class="ce-radar-node-dot" />
											<text
												x={v.lx}
												y={v.ly}
												text-anchor={v.anchor}
												dominant-baseline="middle"
												class="ce-radar-node-label">
												{v.code} {v.title}
											</text>
										</g>
									))
								}
							</svg>

							<!-- 移动端或辅助快速切换药丸 pills -->
							<div class="ce-radar-pills" role="tablist" aria-label="维度快速选择">
								{
									dimensions.map((dim, i) => (
										<button
											type="button"
											class:list={["ce-radar-pill", { "is-active": i === 0 }]}
											data-pill-index={i}
											role="tab"
											aria-selected={i === 0 ? "true" : "false"}
											aria-controls={`radar-panel-${dim.code}`}>
											{dim.code} {dim.title}
										</button>
									))
								}
