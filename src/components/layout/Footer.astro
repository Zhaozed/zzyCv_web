---
import Logo from "@/components/aria/Logo.astro";
import { siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

<footer
	class="relative z-40 mt-auto border-t border-neutral-200 bg-white text-gray-700 dark:border-neutral-800 dark:bg-neutral-950"
>
	<div class="mx-auto flex max-w-7xl flex-col items-center px-7 py-5 sm:flex-row sm:py-6">
		<Logo />
		<p
			class="mt-4 text-sm text-neutral-700 dark:text-neutral-100 sm:mt-0 sm:ml-4 sm:border-l sm:border-neutral-300 sm:pl-4 dark:sm:border-neutral-700"
		>
			© {year} {siteConfig.author} · AI 产品经理
		</p>
		<div class="mt-4 inline-flex items-center space-x-5 sm:mt-0 sm:ml-auto">
			<a
				href="https://github.com/Zhaozed"
				target="_blank"
				rel="noopener noreferrer"
				title="GitHub 个人主页"
				class="text-neutral-500 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white"
			>
				<span class="sr-only">GitHub</span>
				<svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"
					><path
						fill-rule="evenodd"
						d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
						clip-rule="evenodd"
					></path></svg
				>
			</a>

			<div class="relative inline-flex items-center">
				<a
					href="mailto:18032098113@163.com"
					id="footer-email-btn"
					title="点击发送邮件或复制地址 (18032098113@163.com)"
					aria-label="Email: 18032098113@163.com"
					class="cursor-pointer text-neutral-500 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white"
				>
					<span class="sr-only">Email: 18032098113@163.com</span>
					<svg
						class="h-6 w-6"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
						></path>
					</svg>
				</a>
				<span
					id="email-toast"
					class="pointer-events-none absolute -top-9 right-0 z-50 whitespace-nowrap rounded-md bg-neutral-900 px-2.5 py-1 text-xs font-medium text-white shadow-lg opacity-0 transition-opacity duration-200 dark:bg-white dark:text-neutral-900"
				>
					已复制邮箱: 18032098113@163.com
				</span>
			</div>
		</div>
	</div>
</footer>

<script>
	const emailBtn = document.getElementById("footer-email-btn");
	const emailToast = document.getElementById("email-toast");
	if (emailBtn) {
		emailBtn.addEventListener("click", () => {
			navigator.clipboard.writeText("18032098113@163.com").then(() => {
				if (emailToast) {
					emailToast.classList.remove("opacity-0");
					setTimeout(() => {
						emailToast.classList.add("opacity-0");
					}, 2000);
				}
			});
		});
	}
</script>
