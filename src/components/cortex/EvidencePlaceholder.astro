---
interface Props {
	id: string;
	title: string;
	description: string;
	format?: string;
	visible?: boolean;
	compact?: boolean;
}
const { id, title, description, format, visible = true, compact = false } = Astro.props;
---

{
	visible && (
		<aside class:list={["evidence-placeholder", { compact }]} aria-label={`待补素材：${title}`}>
			<div class="placeholder-top">
				<>
					<span>素材 {id}</span>
					<span>待补充</span>
				</>
			</div>
			<div class="placeholder-body">
				<span class="placeholder-symbol" aria-hidden="true">
					＋
				</span>
				<strong>{title}</strong>
				<p>{description}</p>
			</div>
			{format && <p class="placeholder-format">{format}</p>}
		</aside>
	)
}

<style>
	.evidence-placeholder {
		border: 1px dashed var(--ca-line);
		border-radius: 12px;
		padding: 20px 24px;
		background: var(--ca-soft);
		color: var(--ca-muted);
	}
	.placeholder-top {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		font-size: 11px;
		letter-spacing: 0.08em;
	}
	.placeholder-top span:last-child {
		color: var(--ca-accent);
	}
	.placeholder-body {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 24px 0 18px;
	}
	.placeholder-symbol {
		font-size: 24px;
		line-height: 1;
		margin-bottom: 12px;
		font-weight: 300;
	}
	strong {
		font-size: 17px;
		font-weight: 500;
		color: var(--ca-text);
	}
	.placeholder-body p {
		max-width: 560px;
		margin-top: 8px;
		font-size: 14px;
		line-height: 1.8;
	}
	.placeholder-format {
		text-align: center;
		font-size: 12px;
		line-height: 1.7;
	}
	.compact .placeholder-body {
		align-items: flex-start;
		text-align: left;
		padding: 14px 0 0;
	}
	.compact .placeholder-symbol {
		display: none;
	}
	.compact .placeholder-format {
		text-align: left;
		margin-top: 12px;
	}
	@media (max-width: 600px) {
		.evidence-placeholder {
			padding: 18px;
		}
	}
</style>
