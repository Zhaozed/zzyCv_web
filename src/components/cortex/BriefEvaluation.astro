---
import {
	attributionDirections,
	caseGtEnhanced,
	triStateBoundaryExamples,
	triStateVerdicts
} from "@/data/cortex-proactive";
import "@/styles/cortex-brief-evaluation.css";
---

<div class="be-evaluation">
	<p class="ca-copy">
		晨间简报需要在有限篇幅内提炼今日重点，质量保障依赖真实闭环而非单点碰运气。我们推行「代码门禁 + 异步质检 + 价值验证」轻量分层机制；更完整的大模型评测体系、自动化批跑与版本门禁能力，详见配套建设的 <a href="/projects/cortex-eval/" style="color:var(--ca-accent); font-weight: 500; text-decoration: underline;">Cortex-Eval 评测平台 ↗</a>。
	</p>

	<!-- 01 核心排障复盘：从「48h 误删未结承诺」看端到端排查 -->
	<section class="be-phase" aria-labelledby="be-case-title" style="margin-top: 20px; padding-top: 0; border-top: 0;">
		<div class="be-phase-head">
			<p class="be-phase-tag">CORE DEFECT REVIEW · 核心排障案例</p>
			<h4 class="be-phase-title" id="be-case-title">
				01 典型缺陷复盘：从「48h 误删未结承诺」看端到端排查
			</h4>
		</div>

		<!-- 核心认知前置 -->
		<div
			style="background: color-mix(in srgb, var(--ca-accent) 8%, var(--ca-soft)); border-left: 3px solid var(--ca-accent); border-radius: 6px; padding: 12px 16px; margin-top: 14px; margin-bottom: 14px; font-size: 13.5px; line-height: 1.65; color: var(--ca-text);">
			<strong>💡 核心认知：只对照模型输入做评测，发现不了进入模型前已经丢失的信息。</strong>
			<div style="font-size: 12.5px; color: var(--ca-muted); margin-top: 4px;">
				离线 LLM Judge 只能核验「输出是否忠实于输入」。若上游规则在数据拼装时将关键待办误切，模型输出看似完全合规，离线质检也会全绿放行（Judge 完全致盲）。排查必须打通端到端链路。
			</div>
		</div>

		<p class="ca-copy">
			在自身深度内测使用时捕获该典型缺陷：3 天前记录了自身承诺 <em>“周五前完成表格翻译”</em>（归属于多语言支持项目），但周五早晨生成的简报中该承诺完全消失。第一反应容易主观归咎于“模型遗漏”，但<strong>调取同次生成的 InputBundle 评测快照</strong>证实，模型根本没有收到该条输入。
		</p>
		<p class="ca-copy" style="margin-top: 6px;">
			<strong>根因与修复：</strong>上游提取规则简单将 <code>updated_at ≤ 48h</code> 作为时序过滤器，导致 3 天前记录但今日到期的未结承诺被误判为历史噪音丢弃（信息新鲜度 ≠ 任务有效性）。我们重构了筛选逻辑，使今日到期待办穿透时间窗保活，并将该缺陷固化为固定防劣化回归用例。当前回归集中未再重现同类遗漏，多用户场景仍需依赖线上持续观测收集长尾异常。
		</p>

		<!-- 典型 Bad Case 闭环对比 -->
		<article class="be-case" aria-labelledby="be-case-heading" style="margin-top: 16px;">
			<div class="be-output-pair">
				<section aria-label="修改前输出">
					<div class="be-output-heading">
						<h5>修改前（仅按 48h 更新时间截断）</h5>
						<span class="be-output-count">遗漏自身核心到期承诺 · 模型无从感知</span>
					</div>
					<blockquote>
						<strong>评测平台对齐</strong>：用例差异卡点待确认，今日 15:00 参加评审。<br />
						<strong>其他待办</strong>：18:00 前提交实习生日报。<br />
						<em
							>（多语言支持项目中，3 天前记录的“周五前完成表格翻译”因超过 48h
							未更新被上游截断切除，导致该项目及到期承诺完全漏报！）</em
						>
					</blockquote>
				</section>
				<section class="be-output-improved" aria-label="修改后输出">
					<div class="be-output-heading">
						<h5>修改后（近期动态 + 今日到期未结待办）</h5>
						<span class="be-output-count">准确召回到期承诺 · 项目归类清晰</span>
					</div>
					<blockquote>
						<strong>评测平台对齐</strong>：用例差异卡点待确认，今日 15:00 参加评审。<br />
						<strong>多语言支持</strong>：<strong style="color:var(--ca-accent);"
							>今日到期：您需在周五前完成表格翻译</strong
						>。<br />
						<strong>其他待办</strong>：18:00 前提交实习生日报。
					</blockquote>
				</section>
			</div>

			<!-- 增强版 Case 评测质检表抽屉 -->
			<details class="ca-details-drawer" style="margin-top: 16px;">
				<summary class="ca-drawer-summary">
					<span class="ca-drawer-title">
						<span aria-hidden="true">🔍</span>
						<strong>展开查看该 Case 评测质检表：</strong>
						<span>严格对照 Gate 1 代码门禁与 Gate 2（D1—D3）三元裁决核验凭证</span>
					</span>
					<span class="ca-drawer-arrow" aria-hidden="true">↓</span>
				</summary>
				<div class="ca-drawer-content" style="padding: 0;">
					<div class="be-table-wrap" style="margin-top: 0;">
						<table class="be-table be-gt-table">
							<caption class="sr-only"
								>典型 Bad Case 对照 Gate 1 代码门禁与 Gate 2 语义质检三元裁决对照</caption
							>
							<thead>
								<tr>
									<th scope="col">质检门禁 / 评测维度</th>
									<th scope="col">核验要点（Rubric 规则对照）</th>
									<th scope="col">修改前裁决</th>
									<th scope="col">修改后裁决</th>
									<th scope="col">评测判定依凭（Force Quote 原文定位）</th>
								</tr>
							</thead>
							<tbody>
								{
									caseGtEnhanced.map(item => (
										<tr>
											<>
												<th scope="row">
													<span
														class:list={{
															"be-badge-critical": item.level === "端到端",
															"be-badge-p0": item.level === "P0",
															"be-badge-p1": item.level === "门禁"
														}}>
															{item.gate}
													</span>
													<div style="font-size: 12px; margin-top: 4px; font-weight: 600; color: var(--ca-text);">
														{item.dimension}
													</div>
												</th>
												<td style="font-size: 12px; color: var(--ca-muted); line-height: 1.5;">
													{item.rule}
												</td>
												<td>
													<span
														class:list={{
															"be-verdict-fail": item.beforeVerdict === "FAIL",
															"be-verdict-pass": item.beforeVerdict === "PASS"
														}}>
														{item.beforeVerdict}
													</span>
													{item.beforeReason && (
														<div style="font-size: 11px; color: var(--ca-muted); margin-top: 3px;">
															{item.beforeReason}
														</div>
													)}
												</td>
												<td>
													<span class="be-verdict-pass">{item.afterVerdict}</span>
													{item.afterReason && (
														<div style="font-size: 11px; color: var(--ca-muted); margin-top: 3px;">
															{item.afterReason}
														</div>
													)}
												</td>
												<td>
													<code class="be-quote-snippet">"{item.quote}"</code>
												</td>
											</>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</div>
			</details>
		</article>

		<!-- 归因定位方法：输入、生成与评测三个环节 -->
		<div style="margin-top: 18px;">
			<h5 style="font-size: 13px; font-weight: 600; color: var(--ca-text); margin-bottom: 8px;">
				归因方法：沿输入、生成与评测三个环节排查，避免甩锅给模型
			</h5>
			<div
				class="be-table-wrap"
				style="margin-top: 0; border: 1px solid var(--ca-line); border-radius: 8px; overflow: hidden; background: var(--ca-soft);">
				<table class="be-table" style="margin: 0;">
					<caption class="sr-only">归因方法：沿输入、生成与评测三个环节定位问题</caption>
					<thead>
						<tr>
							<th scope="col" style="width: 18%;">归因方向</th>
							<th scope="col" style="width: 48%;">排查依据</th>
							<th scope="col" style="width: 34%;">修复位置</th>
						</tr>
					</thead>
					<tbody>
						{
							attributionDirections.map(row => (
								<tr>
									<th scope="row" style="font-weight: 600; color: var(--ca-text);">
										{row.direction}
									</th>
									<td style="font-size: 13px; line-height: 1.6; color: var(--ca-text);">
										{row.basis}
									</td>
									<td style="font-size: 13px; line-height: 1.6; color: var(--ca-muted);">
										{row.fix}
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
			<div
				style="background: color-mix(in srgb, var(--ca-accent) 7%, var(--ca-soft)); border-left: 3px solid var(--ca-accent); border-radius: 6px; padding: 10px 14px; margin-top: 10px; font-size: 12.5px; line-height: 1.65; color: var(--ca-text);">
				本例归属于<strong>输入筛选缺陷</strong>：通过修复 48h 单一时序过滤规则，并将该承诺加入固定回归集闭环。若输入合规但用户仍觉无用，则流转至价值反馈层调优。
			</div>
		</div>
	</section>

	<!-- 02 质检机制设计：代码门禁、语义质检与价值闭环 -->
	<section
		class="be-phase"
		aria-labelledby="be-standards-title"
		style="margin-top: 32px;">
		<div class="be-phase-head">
			<p class="be-phase-tag">Evaluation Framework · 质检体系</p>
			<h4 class="be-phase-title" id="be-standards-title">02 业务质检分工与三层机制</h4>
		</div>

		<!-- 4 步动态闭环流水线 -->
		<div class="be-flow-banner" style="margin-top: 14px; margin-bottom: 20px;">
			<div class="be-flow-step">
				<span class="be-flow-num">1</span>
				<span>真实内测采样</span>
			</div>
			<span class="be-flow-arrow">→</span>
			<div class="be-flow-step">
				<span class="be-flow-num">2</span>
				<span>问题复盘与标准修订</span>
			</div>
			<span class="be-flow-arrow">→</span>
			<div class="be-flow-step">
				<span class="be-flow-num">3</span>
				<span>自动评测与复核</span>
			</div>
			<span class="be-flow-arrow">→</span>
			<div class="be-flow-step">
				<span class="be-flow-num">4</span>
				<span>固定样本回归</span>
			</div>
		</div>

		<!-- 三栏核心分流架构看板 -->
		<div class="be-pipeline-grid">
			<!-- Gate 1 代码门禁 -->
			<div class="be-pipeline-card is-code">
				<div>
					<div class="be-pipeline-header">
						<span class="be-pipeline-tag">Gate 1 · 代码门禁</span>
					</div>
					<h5 class="be-pipeline-title">呈现与确定性约束</h5>
					<ul class="be-pipeline-list">
						<li>
							<strong>结构与口播硬限</strong>：A2UI JSON Schema 校验，语音口播严格 ≤25 字（仅 1 句话），卡片结构化呈现供 5 秒快速扫读。
						</li>
						<li>
							<strong>模态一致性</strong>：语音使用被选事项同一短文本字段，从数据结构上避免两份文本相互矛盾。
						</li>
						<li>
							<strong>单焦点与日程时效</strong>：语音关联单一有效事项；按当前时间、时区和取消状态过滤已结束日程。
						</li>
					</ul>
				</div>
				<div class="be-pipeline-footer">
					<strong>定位分工：</strong>代码仅负责格式与时钟拦截；内容是否瞎编与漏报交给 Gate 2。
				</div>
			</div>

			<!-- Gate 2 语义质检 -->
			<div class="be-pipeline-card is-quality">
				<div>
					<div class="be-pipeline-header">
						<span class="be-pipeline-tag">Gate 2 · 语义质检</span>
					</div>
					<h5 class="be-pipeline-title">对照输入核查（LLM Judge 异步抽检）</h5>
					<ul class="be-pipeline-list">
						<li>
							<strong>D1 事实保真</strong>：主体/时间/状态有输入支持，Force Quote 凭证；删除条件或放大确定性即判失真。
						</li>
						<li>
							<strong>D2 时间有效与降噪</strong>：过滤失效与闲聊，但不将大群广播一律视为噪音；未结承诺保留。
						</li>
						<li>
							<strong>D3 项目归并</strong>：只核查归并依据，不测主观重要性；项目未知独立展示，多项目不强猜。
						</li>
					</ul>
				</div>
				<div class="be-pipeline-footer">
					<strong>三元裁决机制：</strong>逐维度判定（通过／不通过／待复核）；任一维度不通过则整体不通过，歧义样本附带具体原因进入待复核。
				</div>
			</div>

			<!-- Tier 3 价值验证 -->
			<div class="be-pipeline-card is-value">
				<div>
					<div class="be-pipeline-header">
						<span class="be-pipeline-tag">Tier 3 · 用户价值验证</span>
					</div>
					<h5 class="be-pipeline-title">业务效果闭环：验证是否真正减负</h5>
					<ul class="be-pipeline-list">
						<li>
							<strong>有用性与归因</strong>：端侧收集“有帮助／部分／没帮助”分布与具体原因（漏重点/不相关/打扰）。
						</li>
						<li>
							<strong>早期打断率</strong>：播报开始后 3 秒内打断比例（区分停止与追问，不盲目将打断视为负反馈）。
						</li>
						<li>
							<strong>后续行动率</strong>：交付后发起后续执行指令比例；结合案例访谈验证核心减负目标。
						</li>
					</ul>
				</div>
				<div class="be-pipeline-footer">
					<strong>价值衡量准则：</strong>先建立内测基线再定目标；不把主动反馈用户等同于全部用户。
				</div>
			</div>
		</div>

		<!-- 深入查看：Gate 2 语义裁决与典型边界 -->
		<details class="ca-details-drawer" style="margin-top: 14px;">
			<summary class="ca-drawer-summary">
				<span class="ca-drawer-title">
					<span aria-hidden="true">⚖️</span>
					<strong>展开查看 Gate 2 语义裁决机制与 3 类典型边界判定</strong>
					<span>非黑即白一票否决 · 歧义主动暴露待复核 · 不强猜不捏造</span>
				</span>
				<span class="ca-drawer-arrow" aria-hidden="true">↓</span>
			</summary>
			<div class="ca-drawer-content" style="padding: 16px;">
				<div class="be-table-wrap" style="margin-top: 0;">
					<table class="be-table">
						<caption class="sr-only">统一三元裁决标准与处置动作</caption>
						<thead>
							<tr>
								<th scope="col" style="width: 20%;">判定</th>
								<th scope="col" style="width: 44%;">使用条件</th>
								<th scope="col">后续处理</th>
							</tr>
						</thead>
						<tbody>
							{
								triStateVerdicts.map(v => (
									<tr>
										<td>
											<span
												class:list={[
													"be-verdict-tag",
													v.type === "pass" && "be-verdict-pass",
													v.type === "fail" && "be-verdict-fail",
													v.type === "review" && "be-verdict-review"
												]}>
												{v.verdict}
											</span>
										</td>
										<td>{v.condition}</td>
										<td>{v.handling}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</div>
		</details>
	</section>
</div>
