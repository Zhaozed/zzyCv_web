---
const applications = [
	{ name: "Gmail", category: "邮件", icon: "vg_gmail" },
	{ name: "Outlook Mail", category: "邮件", icon: "vg_outlook-mail" },
	{ name: "Todo", category: "待办", icon: "vg_microsoft-todo" },
	{ name: "Calendar", category: "日历", icon: "vg_outlook-calendar" },
	{ name: "ClickUp", category: "项目协作", icon: "vg_clickup" }
];

const coreDesignDecisions = [
	{
		tag: "PRINCIPLE 01",
		title: "高危动作必确认，日常查询不打扰",
		desc: "坚持体验与安全分级：查邮件、看日程等只读操作静默完成，保障交互流畅度；发邮件、删日程等具备外部影响的操作，确认由执行引擎强制拦截，模型不能绕过，绝不依赖大模型概率性的自主判断。"
	},
	{
		tag: "PRINCIPLE 02",
		title: "关键信息有出处，绝不擅自脑补",
		desc: "用户口语表达往往简短模糊。确立产品防错红线：收件人、会议时间等核心参数必须在上下文中有据可查；只要关键信息缺失，必须主动反问对齐，严禁模型凭空脑补发错人或订错时间。"
	},
	{
		tag: "PRINCIPLE 03",
		title: "失败原因说人话，绝不盲目报喜",
		desc: "遇到账号未授权、权限过期或时段冲突时，严禁模型掩盖错误虚假汇报“已搞定”；必须把真实阻断原因翻译成清晰的人话，并直接给出可操作的下一步指引（如一键前往授权绑定）。"
	}
];

const sopSteps = [
	{
		step: "01",
		title: "接口调研与能力盘点",
		tag: "接口调研",
		text: "调研 Gmail、Outlook 等接口，确认支持哪些读写操作、需要什么授权、有哪些必填参数及调用限制。",
		output: "接口能力清单、限制与依赖"
	},
	{
		step: "02",
		title: "场景定义与范围收敛",
		tag: "场景定义",
		text: "将接口能力转成用户场景（如查邮件、回复邮件、查日程、建会议），确定优先级与首期支持范围。",
		output: "场景清单、功能边界、典型用户指令"
	},
	{
		step: "03",
		title: "权限分级与防错规则",
		tag: "权限防错",
		text: "区分只读与高危写操作；明确哪些操作必须确认、哪些必要参数缺失必须追问，以及对象歧义如何消除。",
		output: "权限矩阵、确认与追问规则"
	},
	{
		step: "04",
		title: "交互流程与异常兜底",
		tag: "交互与异常",
		text: "设计从意图识别、参数补齐、确认到执行反馈的完整流程；覆盖未授权、超时、部分失败、取消和重试。",
		output: "交互流程、状态卡片、兜底策略"
	},
	{
		step: "05",
		title: "PRD 输出与研发对接",
		tag: "PRD与对接",
		text: "将场景、接口映射、参数规则、权限校验和异常策略写进 PRD，与研发明确模型和代码各自负责的部分。",
		output: "标准 PRD、接口映射与执行规则"
	},
	{
		step: "06",
		title: "联调验收与规范沉淀",
		tag: "验收沉淀",
		text: "验证正常及异常场景，推动交付上线；将共性规则和踩坑案例回填到接入规范，持续更新测试集。",
		output: "验收用例、回归测试集、更新后的 SOP"
	}
];



---

<!-- Section 03: 办公能力接入与标准化 SOP -->
<section
	class="ca-section ca-closing cl-integrations"
	id="onboarding"
	data-case-section
	aria-labelledby="onboarding-heading">
	<header class="ca-section-head">
		<p class="ca-kicker"><span>03</span> 办公能力接入 · 生态落地</p>
		<h2 id="onboarding-heading">办公能力接入：5 项核心办公应用落地与标准接入 SOP</h2>
		<p class="ca-copy">
			给桌面机器人接入真实办公能力，最大的挑战不是打通接口，而是让用户真正放心把工作交给它。发错一封邮件、订错一场会议都会瞬间摧毁信任。我负责
			5
			项核心办公能力的需求定义与交互设计，制定「高危必确认、缺参必反问、异常说人话」的产品红线，并将经验沉淀为覆盖需求到验收的
			6 步标准接入 SOP。
		</p>
	</header>

	<div class="cl-asset-block ca-reveal">
		<div class="cl-asset-head">
			<span class="cl-asset-tag">接入生态 / PROVIDER ECOSYSTEM</span>
			<h3>负责 5 项核心办公应用能力接入与落地</h3>
			<p class="ca-copy">
				负责 Gmail、Outlook 邮件/日历、Microsoft Todo、ClickUp 等 5
				项高频办公能力的需求定义、接口映射与上线验收，推动机器人从陪伴对话真正迈向办公办事场景。
			</p>
		</div>

		<!-- 5 大办公应用 Logo 条 -->
		<ul class="cl-apps" aria-label="接入的五个办公应用">
			{
				applications.map(app => (
					<li>
						<span class="cl-app-logo" aria-hidden="true">
							<img
								src={`/portfolio/cortex-agent/a2ui-runtime/icons/${app.icon}.svg`}
								width="40"
								height="40"
								alt=""
								loading="lazy"
							/>
						</span>
						<div class="cl-app-label">
							<strong>{app.name}</strong>
							<span>{app.category}</span>
						</div>
					</li>
				))
			}
		</ul>

		<!-- 核心产品原则：AI 办事的交互红线与边界 -->
		<div class="cl-grilling-box ca-reveal">
			<div class="cl-grilling-head">
				<h4><span>产品交互规范</span>给 AI 办事立规矩 · 3 条核心设计原则</h4>
				<p class="ca-copy">
					连通接口容易，但让用户放心把工作交给 AI
					很难。发错一封邮件或订错一场会议都会摧毁信任。我主导确立了 3
					条人机协作原则，在「操作丝滑」与「安全可控」之间守住边界。
				</p>
			</div>
			<div class="cl-grilling-grid">
				{
					coreDesignDecisions.map(p => (
						<div class="cl-grilling-item">
							<span class="cl-grilling-tag">{p.tag}</span>
							<strong>{p.title}</strong>
							<p>{p.desc}</p>
						</div>
					))
				}
			</div>
		</div>


		<!-- 6 步标准接入 SOP 矩阵 -->
		<div class="cl-sop-section ca-reveal">
			<div class="cl-asset-head">
				<span class="cl-asset-tag">标准 SOP / INTAKE STANDARD</span>
				<h3>从接口调研到上线验收的 6 步办公能力接入 SOP</h3>
				<p class="ca-copy">
					从散装对接走向标准化交付：将经验固化为覆盖「接口调研 → 场景定义 → 权限与防错 → 交互与异常设计 → PRD 与研发对接 → 验收与规范沉淀」的 6 步产品流程，让后续新能力接入有据可依。
				</p>
			</div>

			<div class="cl-sop-grid">
				{
					sopSteps.map(item => (
						<div class="cl-sop-card">
							<div class="cl-sop-top">
								<span class="cl-sop-num">{item.step}</span>
								<span class="cl-sop-tag">{item.tag}</span>
							</div>
							<h4>{item.title}</h4>
							<p>{item.text}</p>
							{item.output && (
								<div class="cl-sop-output">
									<strong>产出：</strong>
									<span>{item.output}</span>
								</div>
							)}
						</div>
					))
				}
			</div>

			<div class="cl-sop-footnote">
				<strong>* 机制贯穿与规范复用：</strong>
				「高危必确认、缺参必反问」是贯穿接入全流程的防错底线（03 步定义规则 → 04 步落实交互 → 05 步研发实现 → 06 步用例验证）；并将该 SOP 固化为 <strong>PRD Skill 复用工具</strong>（输入接口文档与场景 → 自动化梳理权限、参数、交互与异常 → 输出标准 PRD 初稿与验收清单），实现「5 项工具交付（实际项目）→ 防错红线（产品规则）→ 6 步 SOP（方法沉淀）→ PRD Skill（复用载体）」的完整支撑闭环。
			</div>
		</div>

		<div class="ca-resources" style="margin-top: 32px;">
			<p class="ca-kicker">继续探索作品集</p>
			<a href="/projects/cortex-eval/">Cortex-Eval 评测平台 <span>↗</span></a>
			<a href="/practice/daymate/">DayMate 桌面端 AI 待办与求职助手 <span>↗</span></a>
			<a href="/practice/">探索其他实践 <span>→</span></a>
		</div>
	</div>
</section>
