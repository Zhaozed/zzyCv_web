---
interface Props {
	class: string;
}
const { class: className } = Astro.props;
const svgClass = `h-2.5 w-2.5 transform stroke-current transition-all ease-in-out duration-200 ${className}`;
---

<svg
	class={svgClass}
	viewBox="0 0 13 15"
	version="1.1"
	xmlns="http://www.w3.org/2000/svg"
>
	<g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round">
		<g transform="translate(0.666667, 2.333333)" stroke="currentColor" stroke-width="2.4">
			<g>
				<polyline
					class="opacity-0 transition-all delay-0 duration-200 ease-out group-hover:opacity-100"
					points="5.33333333 0 10.8333333 5.5 5.33333333 11"
				/>
				<line
					class="-translate-x-1 transform opacity-0 transition-all duration-200 ease-out group-hover:translate-x-0 group-hover:opacity-100"
					x1="10.8333333"
					y1="5.5"
					x2="0.833333333"
					y2="5.16666667"
				/>
			</g>
		</g>
	</g>
</svg>
