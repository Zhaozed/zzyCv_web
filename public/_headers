# Cache static Vite assets with content hashes forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache portfolio images and media with long stale-while-revalidate
/portfolio/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# Cache icons
/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Cache pagefind search index
/pagefind/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
